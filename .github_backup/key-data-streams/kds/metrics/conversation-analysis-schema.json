{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KDS Conversation Analysis Report",
    "description": "Schema for Step 0 conversation history analysis output",
    "type": "object",
    "required": [
        "analysis_date",
        "conversation_period",
        "total_kds_interactions",
        "violations_detected",
        "most_violated_rules",
        "rulebook_alignment_score"
    ],
    "properties": {
        "analysis_date": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when analysis was performed"
        },
        "conversation_period": {
            "type": "string",
            "description": "Date range analyzed (e.g., '2024-12-15 to 2025-01-14')",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} to \\d{4}-\\d{2}-\\d{2}$"
        },
        "total_kds_interactions": {
            "type": "integer",
            "minimum": 0,
            "description": "Total KDS-related interactions in conversation history"
        },
        "violations_detected": {
            "type": "integer",
            "minimum": 0,
            "description": "Total rule violations found"
        },
        "most_violated_rules": {
            "type": "array",
            "description": "Top 5 rules with lowest compliance rates",
            "items": {
                "type": "object",
                "required": [
                    "rule_id",
                    "count",
                    "title",
                    "compliance_rate"
                ],
                "properties": {
                    "rule_id": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 21
                    },
                    "count": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "title": {
                        "type": "string"
                    },
                    "compliance_rate": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "common_issue": {
                        "type": "string"
                    },
                    "recommendation": {
                        "type": "string"
                    }
                }
            },
            "maxItems": 5
        },
        "friction_points": {
            "type": "array",
            "description": "User workflow friction points detected",
            "items": {
                "type": "string"
            }
        },
        "rulebook_alignment_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Overall compliance score (0-100)"
        },
        "router_violations": {
            "type": "array",
            "description": "Router-specific violations (Rule #9, #11, #12, #18)",
            "items": {
                "type": "object",
                "properties": {
                    "rule_id": {
                        "type": "integer"
                    },
                    "description": {
                        "type": "string"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "CRITICAL",
                            "HIGH",
                            "MEDIUM",
                            "LOW"
                        ]
                    }
                }
            }
        },
        "rule_compliance_details": {
            "type": "object",
            "description": "Detailed compliance analysis per rule (1-21)",
            "patternProperties": {
                "^rule_\\d+$": {
                    "type": "object",
                    "properties": {
                        "instances_checked": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "compliance_rate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "violations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "description": {
                                        "type": "string"
                                    },
                                    "severity": {
                                        "type": "string",
                                        "enum": [
                                            "CRITICAL",
                                            "HIGH",
                                            "MEDIUM",
                                            "LOW"
                                        ]
                                    },
                                    "context": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "workflow_effectiveness": {
            "type": "object",
            "properties": {
                "document_first_adherence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "tdd_success_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "handoff_quality_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "auto_chain_behavior": {
                    "type": "string",
                    "enum": [
                        "working",
                        "needs_improvement",
                        "broken"
                    ]
                },
                "key_visibility_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        },
        "success_patterns": {
            "type": "array",
            "description": "Workflows that worked exceptionally well",
            "items": {
                "type": "string"
            }
        },
        "recommendations": {
            "type": "array",
            "description": "Actionable recommendations for rulebook improvements",
            "items": {
                "type": "object",
                "properties": {
                    "category": {
                        "type": "string",
                        "enum": [
                            "rule_clarification",
                            "new_rule",
                            "rule_relaxation",
                            "validation_enhancement",
                            "prompt_update"
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "P0",
                            "P1",
                            "P2"
                        ]
                    }
                }
            }
        }
    }
}