{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=KSESSIONS_DEV;User ID=sa;Password=YOUR_PASSWORD;Connection Timeout=3600;MultipleActiveResultSets=true;TrustServerCertificate=True;Encrypt=False;",
    "_Comment": "Development connection string - references config/sharedsettings.json Development connection. Uses KSESSIONS_DEV database.",
    "_MacNote": "On Mac: Copy this file to appsettings.Development.json and use Server=192.168.1.158,1433",
    "_WindowsNote": "On Windows: Copy this file to appsettings.Development.json and use Server=AHHOME"
  },
  "Features": {
    "UseSimplifiedSchema": true
  },
  "Development": {
    "ShowDevPanels": true,
    "EnableDebugFeatures": true
  },
  "DebugConfiguration": {
    "EnableDebugMode": true,
    "DebugComponents": {
      "Authentication": true,
      "SessionManagement": true,
      "DatabaseOperations": true,
      "SignalRHubs": true,
      "HttpClient": true,
      "ComponentLifecycle": true,
      "Performance": true,
      "McBeatch": true,
      "Branding": true,
      "Assets": true,
      "RTL": true,
      "CrossApp": true
    },
    "LogLevels": {
      "Console": "Debug",
      "Browser": "Information",
      "File": "Debug",
      "Performance": "Information"
    },
    "PerformanceThresholds": {
      "SlowOperationMs": 1000,
      "VerySlowOperationMs": 5000,
      "DatabaseQueryMs": 500
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.AspNetCore.SignalR": "Debug",
        "System": "Information",
        "NoorCanvas": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/noor-canvas-dev-.txt",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 24,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "DetailedErrors": true,
  "Observer": {
    "Enabled": true,
    "DiagnosticMode": true,
    "StreamEndpoint": "/observer/stream"
  },
  "IssueTracker": {
    "Enabled": true,
    "AutoCapture": true,
    "MaxIssuesPerSession": 100
  },
  "OpenAI": {
    "ApiKey": "",
    "VisionDeploymentName": "gpt-4o",
    "Notes": "Development environment OpenAI configuration. For testing screenshot analysis features."
  }
}
