@* [DIAGNOSTIC:annotation-panel:component] Floating Annotation Panel for HCP *@
@* Shows compact icon-based annotation tools after asset broadcast *@

@if (IsVisible)
{
    <div class="floating-annotation-panel" 
         style="@GetPanelStyle()"
         @onmousedown="OnMouseDown"
         @onmousedown:preventDefault>
        
        <!-- Drag Handle -->
        <div class="panel-header" style="cursor:move;background:#D4AF37;color:white;padding:0.5rem;border-radius:0.5rem 0.5rem 0 0;display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.875rem;font-weight:600;">✏️ Annotate</span>
            <button @onclick="Close" 
                    style="background:transparent;border:none;color:white;cursor:pointer;font-size:1rem;padding:0 0.25rem;">
                ×
            </button>
        </div>
        
        <!-- Tool Icons -->
        <div class="panel-tools" style="display:flex;gap:0.5rem;padding:0.5rem;background:white;border-radius:0 0 0.5rem 0.5rem;">
            
            <!-- Select Tool -->
            <button class="tool-btn @(CurrentTool == "select" ? "active" : "")" 
                    data-tool="select"
                    title="Select"
                    @onclick='() => SelectTool("select")'>
                <i class="fa-solid fa-mouse-pointer"></i>
            </button>
            
            <!-- Laser Tool -->
            <button class="tool-btn @(CurrentTool == "laser" ? "active" : "")" 
                    data-tool="laser"
                    title="Laser Pointer"
                    @onclick='() => SelectTool("laser")'>
                <i class="fa-solid fa-pencil"></i>
            </button>
            
            <!-- Draw Tool -->
            <button class="tool-btn @(CurrentTool == "draw" ? "active" : "")" 
                    data-tool="draw"
                    title="Draw"
                    @onclick='() => SelectTool("draw")'>
                <i class="fa-solid fa-pen"></i>
            </button>
            
            <!-- Highlight Tool -->
            <button class="tool-btn @(CurrentTool == "highlight" ? "active" : "")" 
                    data-tool="highlight"
                    title="Highlight"
                    @onclick='() => SelectTool("highlight")'>
                <i class="fa-solid fa-highlighter"></i>
            </button>
            
            <!-- Note Tool -->
            <button class="tool-btn @(CurrentTool == "note" ? "active" : "")" 
                    data-tool="note"
                    title="Add Note"
                    @onclick='() => SelectTool("note")'>
                <i class="fa-solid fa-sticky-note"></i>
            </button>
            
            <!-- Color Picker -->
            <input type="color" 
                   value="@CurrentColor" 
                   @onchange="OnColorChange"
                   title="Color"
                   style="width:2rem;height:2rem;border:2px solid #D4AF37;border-radius:0.25rem;cursor:pointer;" />
            
            <!-- Clear All -->
            <button class="tool-btn" 
                    title="Clear All Annotations"
                    @onclick="ClearAll"
                    style="margin-left:auto;background:#dc2626;color:white;">
                <i class="fa-solid fa-trash"></i>
            </button>
        </div>
    </div>
}

<style>
    .floating-annotation-panel {
        position: fixed;
        z-index: 9999;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        border-radius: 0.5rem;
        border: 2px solid #D4AF37;
        user-select: none;
    }
    
    .tool-btn {
        width: 2rem;
        height: 2rem;
        border: 2px solid #D4AF37;
        border-radius: 0.25rem;
        background: #f3f4f6;
        color: #374151;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    
    .tool-btn:hover {
        background: #D4AF37;
        color: white;
        transform: scale(1.1);
    }
    
    .tool-btn.active {
        background: #D4AF37;
        color: white;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.3);
    }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnToolChanged { get; set; }
    [Parameter] public EventCallback<string> OnColorChanged { get; set; }
    [Parameter] public EventCallback OnClearAll { get; set; }
    
    private string CurrentTool { get; set; } = "select";
    private string CurrentColor { get; set; } = "#ffff00";
    private double PanelX { get; set; } = 100;
    private double PanelY { get; set; } = 100;
    private bool IsDragging { get; set; }
    private double DragStartX { get; set; }
    private double DragStartY { get; set; }
    
    private string GetPanelStyle()
    {
        return $"left:{PanelX}px;top:{PanelY}px;";
    }
    
    private async Task SelectTool(string tool)
    {
        CurrentTool = tool;
        await OnToolChanged.InvokeAsync(tool);
    }
    
    private async Task OnColorChange(ChangeEventArgs e)
    {
        CurrentColor = e.Value?.ToString() ?? "#ffff00";
        await OnColorChanged.InvokeAsync(CurrentColor);
    }
    
    private async Task ClearAll()
    {
        await OnClearAll.InvokeAsync();
    }
    
    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
    
    private void OnMouseDown(MouseEventArgs e)
    {
        // Start dragging
        IsDragging = true;
        DragStartX = e.ClientX - PanelX;
        DragStartY = e.ClientY - PanelY;
    }
}
