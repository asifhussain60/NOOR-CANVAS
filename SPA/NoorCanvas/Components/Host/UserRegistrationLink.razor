@* User Registration Link Component - Extracted from HostControlPanel *@
@* [DEBUG-WORKITEM:hcp-participant-links:simple] Redesigned with 2 simple buttons for Asset Canvas and Transcript Canvas *@
@* [REDESIGN:canvas-receivers:UI] Compact icon-only buttons with clear selected state (3px dark border, light green background) ;CLEANUP_OK *@
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime

@if (!string.IsNullOrEmpty(UserToken))
{
    @* [DEBUG-WORKITEM:hcp:simple] Container border reduced to 1px for subtler appearance *@
    <div style="width:100%;background-color:#F0F9FF;border-radius:0.75rem;border:1px solid #3B82F6;padding:1.25rem;margin-bottom:1rem;">
        <h4 style="display:flex;align-items:center;justify-content:center;gap:0.5rem;font-weight:700;font-size:1rem;color:#3B82F6;margin:0 0 1.25rem 0;text-align:center;letter-spacing:0.025em;">
            <i class="fa-solid fa-users" style="color:#3B82F6;font-size:1.125rem;"></i>
            <span>SELECT PARTICIPANT CANVAS</span>
        </h4>
        
        @* [REDESIGN:canvas-receivers:UI] Tile buttons with captions, compact spacing, accessible states *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;align-items:start;">
            <!-- Asset Canvas Option -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;">
                <button type="button"
                        aria-pressed="@(selectedCanvas == "asset")"
                        @onclick="CopyAssetCanvasLink"
                        style="@GetAssetButtonStyle()"
                        title="Select Asset Canvas (Q&A)">
                    <div style="display:flex;align-items:center;justify-content:center;height:64px;width:100%;">
                        <i class="fa-solid fa-comments" style="font-size:3rem;color:royalblue;"></i>
                    </div>
                </button>
                <div style="font-weight:700;font-size:0.9rem;color:#1E40AF;letter-spacing:0.015em;">Asset Canvas</div>
            </div>

            <!-- Transcript Canvas Option -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;">
                <button type="button"
                        aria-pressed="@(selectedCanvas == "transcript")"
                        @onclick="CopyTranscriptCanvasLink"
                        style="@GetTranscriptButtonStyle()"
                        title="Select Transcript Canvas (Content Sharing)">
                    <div style="display:flex;align-items:center;justify-content:center;height:64px;width:100%;">
                        <i class="fa-solid fa-scroll" style="font-size:3rem;color:royalblue;"></i>
                    </div>
                </button>
                <div style="font-weight:700;font-size:0.9rem;color:#1E40AF;letter-spacing:0.015em;">Transcript Canvas</div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string UserToken { get; set; } = "";
    [Parameter] public string BaseUrl { get; set; } = "https://localhost:9091";
    [Parameter] public EventCallback<string> OnLinkCopied { get; set; }
    @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Expose selected canvas type for parent component ;CLEANUP_OK *@
    [Parameter] public EventCallback<string> OnCanvasSelected { get; set; }

    @* [DEBUG-WORKITEM:hcp-participant-links:simple] Copy state for each canvas button *@
    private bool isAssetCopied = false;
    private bool isTranscriptCopied = false;
    @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Track which canvas button is pressed (sticky state) ;CLEANUP_OK *@
    private string selectedCanvas = ""; // "asset" or "transcript"
    
    @* [DEBUG-WORKITEM:hcp-participant-links:simple] URL properties for both canvas types *@
    private string AssetCanvasUrl => $"{BaseUrl}/session/canvas/{UserToken}";
    private string TranscriptCanvasUrl => $"{BaseUrl}/transcript/canvas/{UserToken}";

    @* [DEBUG-WORKITEM:hcp-participant-links:simple] Copy handler for Asset Canvas (SessionCanvas) *@
    @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Updated to set sticky state and notify parent ;CLEANUP_OK *@
    private async Task CopyAssetCanvasLink()
    {
        try
        {
            if (!string.IsNullOrEmpty(UserToken))
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", AssetCanvasUrl);
                isAssetCopied = true;
                @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Set sticky pressed state for Asset Canvas ;CLEANUP_OK *@
                selectedCanvas = "asset";
                
                @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Notify parent component of canvas selection ;CLEANUP_OK *@
                if (OnCanvasSelected.HasDelegate)
                {
                    await OnCanvasSelected.InvokeAsync("asset");
                }
                
                StateHasChanged();
                
                if (OnLinkCopied.HasDelegate)
                {
                    await OnLinkCopied.InvokeAsync(AssetCanvasUrl);
                }
                
                // Reset copy state after 2 seconds
                await Task.Delay(2000);
                isAssetCopied = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying Asset Canvas URL to clipboard: {ex.Message}");
        }
    }

    @* [DEBUG-WORKITEM:hcp-participant-links:simple] Copy handler for Transcript Canvas *@
    @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Updated to set sticky state and notify parent ;CLEANUP_OK *@
    private async Task CopyTranscriptCanvasLink()
    {
        try
        {
            if (!string.IsNullOrEmpty(UserToken))
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", TranscriptCanvasUrl);
                isTranscriptCopied = true;
                @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Set sticky pressed state for Transcript Canvas ;CLEANUP_OK *@
                selectedCanvas = "transcript";
                
                @* [DEBUG-WORKITEM:hcp-sticky-buttons:simple] Notify parent component of canvas selection ;CLEANUP_OK *@
                if (OnCanvasSelected.HasDelegate)
                {
                    await OnCanvasSelected.InvokeAsync("transcript");
                }
                
                StateHasChanged();
                
                if (OnLinkCopied.HasDelegate)
                {
                    await OnLinkCopied.InvokeAsync(TranscriptCanvasUrl);
                }
                
                // Reset copy state after 2 seconds
                await Task.Delay(2000);
                isTranscriptCopied = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying Transcript Canvas URL to clipboard: {ex.Message}");
        }
    }

    @* [REDESIGN:canvas-receivers:UI] Standard tile button: full width of cell, compact height; selected: light-green background & 3px dark border *@
    @* Selected: #ECFDF5 with #064E3B 3px border; Unselected: #F8FAFC with #CBD5E1 border; Focus ring for accessibility *@
    private string GetAssetButtonStyle()
    {
        var baseStyle = "width:100%;min-height:80px;padding:0.5rem;border-radius:1rem;cursor:pointer;transition:background-color 0.15s ease,border-color 0.15s ease;outline-offset:2px;border:2px solid;display:flex;align-items:center;justify-content:center;";
        
        if (isAssetCopied)
        {
            @* Temporary success state (same as selected) *@
            return baseStyle + "background:#ECFDF5;color:#064E3B;border-width:3px;border-color:#006400;";
        }
        else if (selectedCanvas == "asset")
        {
            @* SELECTED state - Light green background, dark 3px border *@
            return baseStyle + "background:#ECFDF5;color:#064E3B;border-width:3px;border-color:#006400;";
        }
        else
        {
            @* UNSELECTED state - Subtle neutral background *@
            return baseStyle + "background:#F8FAFC;color:#1F2937;border-color:#CBD5E1;";
        }
    }

    @* [REDESIGN:canvas-receivers:UI] Mirror styles for transcript button *@
    private string GetTranscriptButtonStyle()
    {
        var baseStyle = "width:100%;min-height:80px;padding:0.5rem;border-radius:1rem;cursor:pointer;transition:background-color 0.15s ease,border-color 0.15s ease;outline-offset:2px;border:2px solid;display:flex;align-items:center;justify-content:center;";
        
        if (isTranscriptCopied)
        {
            @* Temporary success state (same as selected) *@
            return baseStyle + "background:#ECFDF5;color:#064E3B;border-width:3px;border-color:#006400;";
        }
        else if (selectedCanvas == "transcript")
        {
            @* SELECTED state - Light green background, dark 3px border *@
            return baseStyle + "background:#ECFDF5;color:#064E3B;border-width:3px;border-color:#006400;";
        }
        else
        {
            @* UNSELECTED state - Subtle neutral background *@
            return baseStyle + "background:#F8FAFC;color:#1F2937;border-color:#CBD5E1;";
        }
    }

    @* [DEBUG-WORKITEM:hcp-participant-links:simple] Copy icon indicator *@
    private string GetCopyIcon(bool isCopied)
    {
        return isCopied ? "fa-solid fa-check" : "fa-solid fa-copy";
    }
}