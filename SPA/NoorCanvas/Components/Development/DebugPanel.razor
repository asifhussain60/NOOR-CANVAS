@using NoorCanvas.Services.Development
@using NoorCanvas.Models.Debug
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@implements IDisposable
@inject IDevModeService DevModeService
@inject ILogger<DebugPanel> Logger
@inject DialogService DialogService
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

@* Only render debug panel in development mode *@
@if (DevModeService.ShowDevPanels)
{
    <div class="debug-panel @(_isExpanded ? "expanded" : "collapsed")" 
         style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
        
        @* Toggle Button *@
        <button @onclick="TogglePanel" 
                class="debug-toggle-btn bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg transition-all duration-200 ease-in-out"
                style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer;">
            <i class="fas @(_isExpanded ? "fa-times" : "fa-bug") text-lg text-white"></i>
        </button>
        
        @* Debug Panel Content *@
        @if (_isExpanded)
        {
            <div class="debug-content bg-gray-800 border border-gray-600 rounded-lg shadow-xl mt-2 p-4"
                 style="min-width: 300px; max-width: 400px;">
                
                @* Header *@
                <div class="debug-header flex items-center justify-between mb-3 pb-2 border-b border-gray-600">
                    <h3 class="text-sm font-bold text-white flex items-center">
                        <i class="fas fa-bug text-blue-400 mr-2"></i>
                        Debug Panel
                    </h3>
                    <span class="text-xs text-gray-300 bg-gray-700 px-2 py-1 rounded">
                        DEV MODE
                    </span>
                </div>
                
                @* Current Page Info *@
                <div class="debug-info mb-3">
                    <div class="text-xs text-gray-300 mb-1">Current View:</div>
                    <div class="text-sm font-mono text-white bg-gray-700 px-2 py-1 rounded">
                        @CurrentViewName
                    </div>
                </div>
                
                @* Debug Actions *@
                <div class="debug-actions space-y-2">
                    @if (DebugActions?.Any() == true)
                    {
                        @foreach (var action in DebugActions)
                        {
                            <button @onclick="@(() => HandleDebugAction(action))" 
                                    disabled="@(_isProcessing || !action.IsEnabled)"
                                    class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white py-2 px-3 rounded-lg transition-colors duration-200 flex items-center text-sm"
                                    title="@action.Description">
                                @if (_isProcessing && _currentAction == action)
                                {
                                    <i class="fas fa-spinner fa-spin mr-2"></i>
                                }
                                else
                                {
                                    <i class="@action.IconClass mr-2"></i>
                                }
                                <span>@action.Name</span>
                            </button>
                        }
                    }
                    else if (OnEnterTestData.HasDelegate)
                    {
                        <button @onclick="HandleEnterTestData" 
                                disabled="@_isProcessing"
                                class="w-full bg-green-600 hover:bg-green-700 disabled:bg-gray-400 text-white py-2 px-4 rounded-lg transition-colors duration-200 flex items-center justify-center">
                            @if (_isProcessing)
                            {
                                <i class="fas fa-spinner fa-spin mr-2"></i>
                                <span>Processing...</span>
                            }
                            else
                            {
                                <i class="fas fa-database mr-2"></i>
                                <span>Enter Test Data</span>
                            }
                        </button>
                    }
                    else
                    {
                        <div class="text-xs text-gray-300 text-center py-3 bg-gray-700 rounded-lg">
                            <i class="fas fa-info-circle mr-1"></i>
                            @GenericMessage
                        </div>
                    }
                </div>
                

                
                @* Debug Info (collapsible) *@
                <div class="debug-details mt-3 pt-3 border-t border-gray-200">
                    <button @onclick="ToggleDetails" 
                            class="w-full text-left text-xs text-gray-300 hover:text-white flex items-center justify-between">
                        <span>System Info</span>
                        <i class="fas @(_showDetails ? "fa-chevron-up" : "fa-chevron-down")"></i>
                    </button>
                    
                    @if (_showDetails)
                    {
                        <div class="mt-2 text-xs text-gray-300 space-y-1">
                            <div>Environment: @_environment</div>
                            <div>Database: @_databaseName</div>
                            <div>Server: @_serverName</div>
                            <div>Timestamp: @DateTime.Now.ToString("HH:mm:ss")</div>
                            <div>Debug Features: @(DevModeService.EnableDebugFeatures ? "Enabled" : "Disabled")</div>
                            <div>Debug Toasts: @(ShowDebugToasts ? "Enabled" : "Disabled")</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string CurrentViewName { get; set; } = "Unknown";
    [Parameter] public EventCallback OnEnterTestData { get; set; }
    [Parameter] public List<IDebugAction>? DebugActions { get; set; }
    [Parameter] public string GenericMessage { get; set; } = "No debug actions available for this view";
    [Parameter] public bool ShowDebugToasts { get; set; } = true;
    
    private bool _isExpanded = false;
    private bool _showDetails = false;
    private bool _isProcessing = false;
    private IDebugAction? _currentAction = null;
    private string _environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Unknown";
    private string _databaseName = "Unknown";
    private string _serverName = "Unknown";
    
    protected override void OnInitialized()
    {
        Logger.LogDebug("NOOR-DEBUG-PANEL: Initialized debug panel for view: {ViewName}", CurrentViewName);
        
        // Extract database connection info
        try
        {
            var connectionString = Configuration.GetConnectionString("DefaultConnection");
            
            if (!string.IsNullOrEmpty(connectionString))
            {
                var parts = connectionString.Split(';');
                
                foreach (var part in parts)
                {
                    var keyValue = part.Split('=', 2);
                    if (keyValue.Length == 2)
                    {
                        var key = keyValue[0].Trim();
                        var value = keyValue[1].Trim();
                        
                        if (key.Equals("Database", StringComparison.OrdinalIgnoreCase) || 
                            key.Equals("Initial Catalog", StringComparison.OrdinalIgnoreCase))
                        {
                            _databaseName = value;
                        }
                        else if (key.Equals("Server", StringComparison.OrdinalIgnoreCase) || 
                                 key.Equals("Data Source", StringComparison.OrdinalIgnoreCase))
                        {
                            _serverName = value;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "NOOR-DEBUG-PANEL: Error extracting database connection info");
        }
    }
    
    private void TogglePanel()
    {
        _isExpanded = !_isExpanded;
        Logger.LogDebug("NOOR-DEBUG-PANEL: Panel toggled - Expanded: {IsExpanded}", _isExpanded);
        StateHasChanged();
    }
    
    private void ToggleDetails()
    {
        _showDetails = !_showDetails;
        StateHasChanged();
    }
    
    private async Task HandleDebugAction(IDebugAction action)
    {
        if (_isProcessing || !action.IsEnabled) return;
        
        try
        {
            _isProcessing = true;
            _currentAction = action;
            StateHasChanged();
            
            Logger.LogInformation("NOOR-DEBUG-PANEL: Executing debug action '{ActionName}' for view: {ViewName}", action.Name, CurrentViewName);
            
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Before ExecuteAsync - Action: {ActionName} ;CLEANUP_OK", action.Name);
            
            await action.ExecuteAsync();
            
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] After ExecuteAsync - Success ;CLEANUP_OK");
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] ShowDebugToasts={ShowDebugToasts}, Toast display DISABLED (per task: remove toasts from screenshots) ;CLEANUP_OK", ShowDebugToasts);
            
            // DISABLED: Toast notifications removed from UI per user request
            // Original code:
            // if (ShowDebugToasts)
            // {
            //     await DialogService.ShowSuccessAsync($"'{action.Name}' completed successfully", "Debug Action");
            // }
            
            _isExpanded = false;
            
            Logger.LogInformation("NOOR-DEBUG-PANEL: Debug action '{ActionName}' completed successfully", action.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Exception caught - Action: {ActionName}, Error: {ErrorMessage} ;CLEANUP_OK", action.Name, ex.Message);
            Logger.LogError("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Error toast display DISABLED (per task: remove toasts from screenshots) ;CLEANUP_OK");
            
            // DISABLED: Error toast notifications removed from UI per user request
            // Original code:
            // await DialogService.ShowAlertAsync($"Error executing '{action.Name}': {ex.Message}", "Debug Action Error", Components.Dialogs.AlertDialog.AlertType.Error);
            
            _isExpanded = false;
            
            Logger.LogError(ex, "NOOR-DEBUG-PANEL: Error executing debug action '{ActionName}' for view: {ViewName}", action.Name, CurrentViewName);
        }
        finally
        {
            _isProcessing = false;
            _currentAction = null;
            StateHasChanged();
        }
    }

    private async Task HandleEnterTestData()
    {
        if (_isProcessing) return;
        
        try
        {
            _isProcessing = true;
            StateHasChanged();
            
            Logger.LogInformation("NOOR-DEBUG-PANEL: Entering test data for view: {ViewName}", CurrentViewName);
            
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Before OnEnterTestData.InvokeAsync - ViewName: {ViewName} ;CLEANUP_OK", CurrentViewName);
            
            // [DIAGNOSTIC:notyf:silent] Enable silent mode to suppress test data toasts ;CLEANUP_OK
            await JSRuntime.InvokeVoidAsync("eval", "if (window.NoorToast) { window.NoorToast.setSilentMode(true); }");
            
            await OnEnterTestData.InvokeAsync();
            
            // [DIAGNOSTIC:notyf:silent] Disable silent mode after test data operation ;CLEANUP_OK
            await JSRuntime.InvokeVoidAsync("eval", "if (window.NoorToast) { window.NoorToast.setSilentMode(false); }");
            
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] After OnEnterTestData.InvokeAsync - Success ;CLEANUP_OK");
            Logger.LogInformation("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] ShowDebugToasts={ShowDebugToasts}, Test data toast display DISABLED (per task: remove toast from Pasted Image 2) ;CLEANUP_OK", ShowDebugToasts);
            
            // DISABLED: Test data toast notifications removed from UI per user request
            // Original code:
            // if (ShowDebugToasts)
            // {
            //     await DialogService.ShowSuccessAsync($"Test data entered successfully for {CurrentViewName}", "Test Data");
            // }
            
            _isExpanded = false;
            
            Logger.LogInformation("NOOR-DEBUG-PANEL: Test data entry completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Exception caught in HandleEnterTestData - ViewName: {ViewName}, Error: {ErrorMessage} ;CLEANUP_OK", CurrentViewName, ex.Message);
            Logger.LogError("[DEBUG-WORKITEM:toastr:debugpanel:TRACE] Test data error toast display DISABLED (per task: remove toasts from screenshots) ;CLEANUP_OK");
            
            // DISABLED: Test data error toast notifications removed from UI per user request
            // Original code:
            // await DialogService.ShowAlertAsync($"Error entering test data: {ex.Message}", "Test Data Error", Components.Dialogs.AlertDialog.AlertType.Error);
            
            _isExpanded = false;
            
            Logger.LogError(ex, "NOOR-DEBUG-PANEL: Error entering test data for view: {ViewName}", CurrentViewName);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }
    
    public void Dispose()
    {
        // Cleanup if needed
    }
}