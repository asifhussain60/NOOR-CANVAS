@page "/session/ended"
@page "/session/ended/{SessionId:int?}"
@layout EmptyLayout
@inject NavigationManager Navigation
@inject ILogger<SessionEnded> Logger

<PageTitle>Session Ended - NOOR Canvas</PageTitle>

<HeadContent>
    @* All fonts and CDNs are centralized in Pages/_Host.cshtml *@
</HeadContent>

<style>
    /* Root Container - Matching SessionWaiting and UserLanding theme */
    .session-ended-root {
        background-color: #F8F5F1;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 1.5rem;
        font-family: 'Inter', sans-serif;
    }

    .session-ended-container {
        width: 100%;
        max-width: 35rem;
        background-color: #FFFFFF;
        border: 1px solid #e5e7eb;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        border-radius: 1.5rem;
        padding: 2rem 3rem;
        text-align: center;
    }

    /* Logo - Matching UserLanding style */
    .session-ended-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    /* [DEBUG-WORKITEM:css:logo-resize] Logo sizing to 200x200px for desktop ;CLEANUP_OK */
    .session-ended-logo img {
        width: 200px;
        height: 200px;
        object-fit: contain;
    }

    /* [DEBUG-WORKITEM:css:logo-resize] Phone logo sizing maintained at 175x175px ;CLEANUP_OK */
    @@media (max-width: 767px) {
        .session-ended-logo img {
            width: 175px;
            height: 175px;
        }
    }

    /* Content Section */
    .session-ended-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* [DEBUG-WORKITEM:session-end:remove-checkmark] Removed icon container per annotated image requirements ;CLEANUP_OK */

    /* Title - [DEBUG-WORKITEM:session-end:heading-color] Green color matching UserLanding (#006400) ;CLEANUP_OK */
    .session-ended-title {
        font-size: 2.5rem;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        color: #006400;
        margin: 0;
    }

    /* Message */
    .session-ended-message {
        font-family: 'Inter', sans-serif;
        font-size: 1.125rem;
        color: #6B7280;
        margin: 0;
        line-height: 1.6;
    }

    /* [DEBUG-WORKITEM:session-end:remove-info-box] Removed session info box per annotated image requirements ;CLEANUP_OK */

    /* [DEBUG-WORKITEM:session-end:remove-button] Removed button container per annotated image requirements ;CLEANUP_OK */

    /* Timestamp */
    .session-ended-timestamp {
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        color: #9CA3AF;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    /* Mobile Responsive */
    @@media (max-width: 767px) {
        .session-ended-container {
            padding: 1.5rem 2rem;
        }

        .session-ended-title {
            font-size: 2rem;
        }

        .session-ended-message {
            font-size: 1rem;
        }
    }
</style>

<div class="session-ended-root">
    <div class="session-ended-container">
        <!-- Logo - [DEBUG-WORKITEM:session-end:logo-fix] Fixed to match UserLanding.razor path ;CLEANUP_OK -->
        <div class="session-ended-logo">
            <img src="/images/NoorCanvas.png?v=20250924" alt="NOOR Canvas" />
        </div>

        <div class="session-ended-content">
            <!-- [DEBUG-WORKITEM:session-end:remove-checkmark] Removed icon container per annotated image requirements ;CLEANUP_OK -->
            
            <h1 class="session-ended-title">Session Ended</h1>

            <!-- Main Message -->
            <p class="session-ended-message">
                This session has been concluded by the host. Thank you for participating in this learning experience.
            </p>

            <!-- [DEBUG-WORKITEM:session-end:remove-info-box] Removed session info box per annotated image requirements ;CLEANUP_OK -->

            <!-- [DEBUG-WORKITEM:session-end:remove-button] Removed return home button per annotated image requirements ;CLEANUP_OK -->

            <!-- Timestamp -->
            <div class="session-ended-timestamp">
                <i class="fa-solid fa-clock"></i>
                <span>@DateTime.Now.ToString("MMMM d, yyyy h:mm tt")</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? SessionId { get; set; }

    protected override void OnInitialized()
    {
        Logger.LogInformation("[DEBUG-WORKITEM:session-end:page-load] SessionEnded page loaded - SessionId: {SessionId} ;CLEANUP_OK", 
            SessionId?.ToString() ?? "null");
    }

    // [DEBUG-WORKITEM:session-end:remove-button] NavigateToHome method removed with button per annotated image requirements ;CLEANUP_OK
}
