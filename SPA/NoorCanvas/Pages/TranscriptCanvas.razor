    // Enter Key Handler
    private async Task HandleQuestionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:keyboard] Enter key pressed - SessionStatus: {Status}, Enabled: {Enabled}", 
                Model?.SessionStatus ?? "null", Model?.SessionStatus == "Active");
            
            // Prevent submission if session not active
            if (Model?.SessionStatus != "Active")
            {
                Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:keyboard] Question submission blocked - session not active");
                return;
            }
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:keyboard] Enter key submit triggered");
            
            // Prevent default newline behavior
            await SubmitQuestion();
        }
    }
