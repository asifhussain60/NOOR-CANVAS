                var response = await Http.PostAsJsonAsync($"/api/Question/{questionToDelete.QuestionId}/delete", requestPayload);

                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] API response received - StatusCode={StatusCode} ({StatusCodeInt})", 
