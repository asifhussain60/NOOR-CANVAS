    // Q&A Methods
    private async Task SubmitQuestion()
    {
        var requestId = Guid.NewGuid().ToString("N")[..8];
        Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] SubmitQuestion called - EditingQuestionIndex: {EditingIndex}, QuestionInput: '{QuestionText}'", 
            requestId, EditingQuestionIndex?.ToString() ?? "NULL", QuestionInput?.Trim() ?? "NULL");

        if (string.IsNullOrWhiteSpace(QuestionInput) || string.IsNullOrEmpty(SessionToken) || Http == null)
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Validation failed - missing required fields", requestId);
            _lastSubmitSucceeded = false;
            return;
        }

        try
        {
            // Check if we're in edit mode
            if (EditingQuestionIndex.HasValue && Model?.Questions != null && EditingQuestionIndex.Value < Model.Questions.Count)
            {
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Edit mode detected - calling UpdateQuestion", requestId);
                await UpdateQuestion();
                return;
            }

            // Create new question
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Preparing API request payload for new question", requestId);
            var requestPayload = new
            {
                SessionToken = SessionToken,
                QuestionText = QuestionInput.Trim(),
                UserGuid = CurrentUserGuid
            };
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:ownership] [{RequestId}] Submitting question - CurrentUserGuid={CurrentUserGuid}, SessionToken={SessionToken}", 
                requestId, CurrentUserGuid, SessionToken);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Sending POST request to /api/Question/Submit", requestId);
            var response = await Http.PostAsJsonAsync("/api/Question/Submit", requestPayload);

            Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] API response received - StatusCode: {StatusCode}", requestId, response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Question submitted successfully - Response: {Response}", requestId, responseContent);
                
                // Question submitted successfully - clear input
                QuestionInput = "";
                await InvokeAsync(StateHasChanged);
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Question input cleared and UI refreshed", requestId);
                _lastSubmitSucceeded = true;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] User unauthorized - redirecting to landing page. Error: {Error}", requestId, errorContent);
                
                // Redirect to UserLanding.razor with session token for proper authentication
                Navigation.NavigateTo($"/user/landing/{SessionToken}");
                _lastSubmitSucceeded = false;
                return;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Question submission failed: {StatusCode} - {Error}", requestId, response.StatusCode, errorContent);
                _lastSubmitSucceeded = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:submit] [{RequestId}] Exception during question submission: {ExceptionMessage}", requestId, ex.Message);
            _lastSubmitSucceeded = false;
        }
    }

    private async Task UpdateQuestion()
    {
        var requestId = Guid.NewGuid().ToString("N")[..8];
        
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ════════ UPDATE QUESTION CALLED ════════", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Current state:", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - EditingQuestionIndex: {Index}", requestId, EditingQuestionIndex);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - Model.Questions: {QuestionsNull}", requestId, Model?.Questions == null);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - Questions Count: {Count}", requestId, Model?.Questions?.Count ?? 0);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - QuestionInput: '{Input}'", requestId, QuestionInput ?? "NULL");
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - SessionToken: {Token}", requestId, SessionToken ?? "NULL");
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - Http: {HttpNull}", requestId, Http == null);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - CurrentUserGuid: {UserGuid}", requestId, CurrentUserGuid ?? "NULL");
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - HubConnection State: {State}", requestId, hubConnection?.State.ToString() ?? "NULL");
        
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] UpdateQuestion CALLED - EditingQuestionIndex={Index}", EditingQuestionIndex);
        
        if (!EditingQuestionIndex.HasValue || Model?.Questions == null || EditingQuestionIndex.Value >= Model.Questions.Count)
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ❌ Invalid edit state - EditingQuestionIndex={Index}, QuestionsCount={Count}", 
                requestId, EditingQuestionIndex, Model?.Questions?.Count);
            Logger.LogWarning("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Invalid edit state", requestId);
            return;
        }

        if (string.IsNullOrWhiteSpace(QuestionInput) || string.IsNullOrEmpty(SessionToken) || Http == null)
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ❌ Validation failed - QuestionInput empty={Empty}, SessionToken empty={TokenEmpty}, Http null={HttpNull}",
                requestId, string.IsNullOrWhiteSpace(QuestionInput), string.IsNullOrEmpty(SessionToken), Http == null);
            Logger.LogWarning("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Validation failed - missing required fields", requestId);
            return;
        }

        try
        {
            var questionToUpdate = Model.Questions[EditingQuestionIndex.Value];
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Question to update found:", requestId);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - QuestionId: {QuestionId}", requestId, questionToUpdate.QuestionId);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - OldText: '{OldText}'", requestId, 
                questionToUpdate.Text?.Substring(0, Math.Min(50, questionToUpdate.Text?.Length ?? 0)));
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - NewText: '{NewText}'", requestId,
                QuestionInput.Trim().Substring(0, Math.Min(50, QuestionInput.Trim().Length)));
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - API Endpoint: /api/Question/{QuestionId}/update", 
                requestId, questionToUpdate.QuestionId);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Updating question - QuestionId: {QuestionId}, NewText: '{NewText}'", 
                requestId, questionToUpdate.QuestionId, QuestionInput.Trim());

            var requestPayload = new
            {
                SessionToken = SessionToken,
                QuestionText = QuestionInput.Trim(),
                UserGuid = CurrentUserGuid
            };

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Sending UPDATE request...", requestId);
            var response = await Http.PostAsJsonAsync($"/api/Question/{questionToUpdate.QuestionId}/update", requestPayload);

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] API response received - StatusCode={StatusCode} ({StatusCodeInt})", 
                requestId, response.StatusCode, (int)response.StatusCode);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:update] [{RequestId}] API response received - StatusCode: {StatusCode}", requestId, response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ✅ Update API call SUCCESS - Response: {Response}", 
                    requestId, responseContent);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Question updated successfully - Response: {Response}", requestId, responseContent);
                
                // Update local model immediately (don't wait for SignalR)
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Updating local model immediately", requestId);
                questionToUpdate.Text = QuestionInput.Trim();
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Local model updated with new text", requestId);
                
                // Clear input and reset edit mode
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Clearing edit state", requestId);
                QuestionInput = "";
                EditingQuestionIndex = null;
                await InvokeAsync(StateHasChanged);
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ✅ Edit mode cleared and UI refreshed", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] Waiting for SignalR QuestionUpdated event...", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Edit mode cleared and UI refreshed", requestId);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ❌ User unauthorized - Error: {Error}", requestId, errorContent);
                Logger.LogWarning("[DEBUG-WORKITEM:canvas:update] [{RequestId}] User unauthorized - Error: {Error}", requestId, errorContent);
                Navigation.NavigateTo($"/user/landing/{SessionToken}");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] ❌ Update API call FAILED - StatusCode={StatusCode}, Error={Error}", 
                    requestId, response.StatusCode, errorContent);
                Logger.LogError("[DEBUG-WORKITEM:canvas:update] [{RequestId}] Question update failed: {StatusCode} - {Error}", requestId, response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}] 💥 EXCEPTION during question update: {ExceptionMessage}", requestId, ex.Message);
            Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:update] [{RequestId}] Exception during question update: {ExceptionMessage}", requestId, ex.Message);
        }
    }

    private async Task VoteQuestion(string questionId)
    {
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ VOTE FLOW START ════════ QuestionId={QuestionId}, UserGuid={UserGuid}, SessionToken={SessionToken}, HubConnection={HubState}", 
            questionId, CurrentUserGuid, SessionToken, hubConnection?.State.ToString() ?? "NULL");
        
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] VoteQuestion CALLED - QuestionId={QuestionId}, UserGuid={UserGuid}, AlreadyVoted={AlreadyVoted}", 
            questionId, CurrentUserGuid, VotedQuestionIds.Contains(questionId));
        
        Logger.LogInformation("[DEBUG-WORKITEM:use-questions:vote] VoteQuestion called for QuestionId={QuestionId}, UserGuid={UserGuid}, AlreadyVoted={AlreadyVoted}", 
            questionId, CurrentUserGuid, VotedQuestionIds.Contains(questionId));
        
        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] CLICK EVENT - User clicked upvote button for QuestionId={QuestionId}", questionId);
        
        // Find current vote count BEFORE API call
        var question = Model?.Questions?.FirstOrDefault(q => q.QuestionId == questionId);
        var currentVotes = question?.Votes ?? -1;
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] BEFORE API CALL - Current vote count={CurrentVotes}, Question found={Found}", 
            currentVotes, question != null);
        
        if (Http == null || string.IsNullOrEmpty(SessionToken))
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:upvote] Vote failed - Http={HttpNull}, SessionToken={TokenNull}", 
                Http == null, string.IsNullOrEmpty(SessionToken));
            Logger.LogWarning("[DEBUG-WORKITEM:use-questions:vote] Vote failed - Http or SessionToken is null");
            return;
        }
        
        // Check if user already voted on this question
        if (VotedQuestionIds.Contains(questionId))
        {
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] User already voted on question {QuestionId} - aborting", questionId);
            Logger.LogInformation("[DEBUG-WORKITEM:use-questions:vote] User already voted on question {QuestionId}", questionId);
            return;
        }
        
        try
        {
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Sending vote request to API - QuestionId={QuestionId}, SessionToken={TokenPreview}",
                questionId, SessionToken.Substring(0, Math.Min(4, SessionToken.Length)) + "...");
            
            Logger.LogDebug("[DEBUG-WORKITEM:use-questions:vote] Sending vote request - QuestionId={QuestionId}, SessionToken={TokenPreview}, Direction=up", 
                questionId, SessionToken.Substring(0, Math.Min(4, SessionToken.Length)) + "...");
            
            var response = await Http.PostAsJsonAsync($"/api/Question/{questionId}/vote", new
            {
                SessionToken = SessionToken,
                Direction = "up",
                UserGuid = CurrentUserGuid
            });

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Vote API response - StatusCode={StatusCode}", response.StatusCode);
            Logger.LogDebug("[DEBUG-WORKITEM:use-questions:vote] Vote response received - StatusCode={StatusCode}", response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                // Mark question as voted
                VotedQuestionIds.Add(questionId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Vote SUCCESS - Added {QuestionId} to VotedQuestionIds, Total voted: {Count}", 
                    questionId, VotedQuestionIds.Count);
                Logger.LogInformation("[DEBUG-WORKITEM:use-questions:vote] Vote successful - Added {QuestionId} to VotedQuestionIds, Total voted: {Count}", 
                    questionId, VotedQuestionIds.Count);
                
                // Vote count will be updated via SignalR
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] WAITING FOR SIGNALR - Vote count should be updated via SignalR broadcast, HubState={HubState}", 
                    hubConnection?.State.ToString() ?? "NULL");
                
                // Check vote count after short delay to see if SignalR updated it
                await Task.Delay(100);
                var questionAfter = Model?.Questions?.FirstOrDefault(q => q.QuestionId == questionId);
                var votesAfter = questionAfter?.Votes ?? -1;
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] AFTER 100ms - Vote count={VotesAfter}, Changed={Changed}", 
                    votesAfter, votesAfter != currentVotes);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:upvote] Vote FAILED - StatusCode={StatusCode}, Error={Error}", 
                    response.StatusCode, errorContent);
                Logger.LogWarning("[DEBUG-WORKITEM:use-questions:vote] Vote failed - StatusCode={StatusCode}, Error={Error}", 
                    response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:upvote] Exception during vote: {Message}", ex.Message);
            Logger.LogError(ex, "[DEBUG-WORKITEM:use-questions:vote] Exception during vote: {Message}", ex.Message);
        }
    }

