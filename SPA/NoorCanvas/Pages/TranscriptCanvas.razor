    private async Task SubmitQuestionFromModal()
    {
        try
        {
            var requestId = Guid.NewGuid().ToString("N")[..8];
            _lastSubmitSucceeded = false;
            if (JSRuntime != null)
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"[TRANSCRIPT-CANVAS] Modal Submit clicked - requestId={requestId}");
            }

            await SubmitQuestion(); // Reuse existing question submission logic

            if (JSRuntime != null)
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"[TRANSCRIPT-CANVAS] Submit completed - success={_lastSubmitSucceeded}, requestId={requestId}");
            }

            if (_lastSubmitSucceeded)
            {
                CloseQuestionModal(); // Close modal only after successful submission
            }
            else
            {
                // Provide gentle feedback in console to assist debugging when submission fails
                if (JSRuntime != null)
                {
                    await JSRuntime.InvokeVoidAsync("console.warn", "Question submission failed or unauthorized. Modal remains open.");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[TRANSCRIPT-CANVAS] Exception in SubmitQuestionFromModal: {Message}", ex.Message);
            if (JSRuntime != null)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"[TRANSCRIPT-CANVAS] Exception in SubmitQuestionFromModal: {ex.Message}");
            }
        }
    }

