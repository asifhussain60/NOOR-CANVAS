<script>
    // [DIAGNOSTIC:hcp-annotate:renderer] SessionCanvas Annotation Renderer ;CLEANUP_OK
    (function() {
        console.log('[DIAGNOSTIC:hcp-annotate:renderer] Initializing SessionCanvas annotation renderer ;CLEANUP_OK');
        
        let participantCanvas = null;
        
        // Initialize Fabric.js canvas for receiving annotations
        function initializeParticipantCanvas() {
            const canvasElement = document.getElementById('sessioncanvas-annotation-canvas');
            if (!canvasElement) {
                console.error('CDN failed, loading local fallback');
                return;
            }
            
            // Check if Fabric.js is loaded
            if (typeof fabric === 'undefined') {
                console.error('CDN failed, loading local fallback');
                return;
            }
            
            // Set canvas dimensions to viewport size
            canvasElement.width = window.innerWidth;
            canvasElement.height = window.innerHeight;
            
            // Initialize Fabric canvas (read-only for participants)
            participantCanvas = new fabric.Canvas('sessioncanvas-annotation-canvas', {
                isDrawingMode: false,
                selection: false,
                backgroundColor: null
            });
            
            // Make all objects non-selectable (participants can only view)
            participantCanvas.selection = false;
            participantCanvas.forEachObject(function(obj) {
                obj.selectable = false;
                obj.evented = false;
            });
            
            console.log('[DIAGNOSTIC:hcp-annotate:renderer] Participant canvas initialized ;CLEANUP_OK');
            
            // Handle window resize
            window.addEventListener('resize', () => {
                if (participantCanvas) {
                    canvasElement.width = window.innerWidth;
                    canvasElement.height = window.innerHeight;
                    participantCanvas.setDimensions({ 
                        width: window.innerWidth, 
                        height: window.innerHeight 
                    });
                }
            });
        }
        
        // Global function to render received annotations
        window.renderAnnotationOnCanvas = function(annotationData) {
            console.log('[DIAGNOSTIC:hcp-annotate:renderer] renderAnnotationOnCanvas called ;CLEANUP_OK', annotationData);
            
            if (!participantCanvas) {
                console.error('CDN failed, loading local fallback');
                return;
            }
            
            try {
                const { annotationType, annotationData: data, timestamp, annotationId } = annotationData;
                
                console.log('[DIAGNOSTIC:hcp-annotate:renderer] Rendering annotation:', annotationType, ';CLEANUP_OK');
                
                // Parse annotation data
                const parsedData = typeof data === 'string' ? JSON.parse(data) : data;
                
                if (annotationType === 'laser') {
                    // Render laser pointer (transient - remove after 1 second)
                    const laserPoint = new fabric.Circle({
                        radius: 8,
                        fill: 'red',
                        opacity: 0.8,
                        left: parsedData.x - 8,
                        top: parsedData.y - 8,
                        selectable: false,
                        evented: false
                    });
                    
                    participantCanvas.add(laserPoint);
                    participantCanvas.renderAll();
                    
                    // Remove after 500ms (laser is transient)
                    setTimeout(() => {
                        participantCanvas.remove(laserPoint);
                        participantCanvas.renderAll();
                    }, 500);
                    
                } else {
                    // Render permanent annotation (path, text, etc.)
                    fabric.util.enlivenObjects([parsedData], (objects) => {
                        objects.forEach(obj => {
                            obj.selectable = false;
                            obj.evented = false;
                            participantCanvas.add(obj);
                        });
                        participantCanvas.renderAll();
                    });
                }
                
                console.log('[DIAGNOSTIC:hcp-annotate:renderer] ? Annotation rendered successfully ;CLEANUP_OK');
            } catch (error) {
                console.error('[DIAGNOSTIC:hcp-annotate:renderer] Error rendering annotation:', error, ';CLEANUP_OK');
            }
        };
        
        // Initialize on DOM ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeParticipantCanvas);
        } else {
            initializeParticipantCanvas();
        }
        
        console.log('[DIAGNOSTIC:hcp-annotate:renderer] SessionCanvas annotation renderer ready ;CLEANUP_OK');
    })();

    // [TRACE-WORKITEM:transcript-canvas:scroll-lock] Participant scroll prevention - host controls position exclusively ;CLEANUP_OK
    (function() {
        console.log('[SCROLL-LOCK] Initializing participant scroll prevention system');
        
        function preventParticipantScrolling() {
            const container = document.querySelector('.canvas-asset-content');
            if (!container) {
                console.warn('[SCROLL-LOCK] Canvas content container not found, retrying...');
                return false;
            }
            
            // Block mouse wheel scrolling
            container.addEventListener('wheel', (e) => {
                e.preventDefault();
                e.stopPropagation();
                console.log('[SCROLL-LOCK] Wheel scroll blocked');
            }, { passive: false });
            
            // Block touch scrolling (mobile)
            container.addEventListener('touchmove', (e) => {
                e.preventDefault();
                console.log('[SCROLL-LOCK] Touch scroll blocked');
            }, { passive: false });
            
            // Block keyboard scrolling (arrow keys, page up/down, home/end)
            container.addEventListener('keydown', (e) => {
                if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', 'Space'].includes(e.key)) {
                    e.preventDefault();
                    console.log('[SCROLL-LOCK] Keyboard scroll blocked:', e.key);
                }
            });
            
            // Also prevent scrolling on the parent canvas-content-area
            const contentArea = document.querySelector('.canvas-content-area');
            if (contentArea) {
                contentArea.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                }, { passive: false });
                
                contentArea.addEventListener('touchmove', (e) => {
                    e.preventDefault();
                }, { passive: false });
            }
            
            console.log('[SCROLL-LOCK] ✅ Participant scroll prevention active - host has exclusive control');
            return true;
        }
        
        // Try to initialize immediately
        if (!preventParticipantScrolling()) {
            // Retry after DOM content loaded
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    setTimeout(preventParticipantScrolling, 500);
                });
            } else {
                setTimeout(preventParticipantScrolling, 500);
            }
        }
    })();

    // [TRACE-WORKITEM:transcript-canvas:scroll-sync] Force participant scroll to host's position ;CLEANUP_OK
    window.forceParticipantScroll = function(scrollPercentage) {
        const container = document.querySelector('.canvas-asset-content');
        if (!container) {
            console.warn('[SCROLL-SYNC] Canvas container not found');
            return;
        }
        
        // Calculate target scroll position based on percentage
        const targetScrollTop = container.scrollHeight * scrollPercentage;
        
        // Force instant scroll (no smooth behavior to ensure tight sync)
        container.scrollTop = targetScrollTop;
        
        console.log(`[SCROLL-SYNC] ✅ Forced to host position: ${(scrollPercentage * 100).toFixed(1)}%`);
    };
</script>
