                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync();
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ✅ Delete API call SUCCESS - Response: {Response}", 
                        requestId, responseContent);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Waiting for SignalR QuestionDeleted event to update UI...", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Question deleted successfully", requestId);
                    // Question will be removed from UI via SignalR notification
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ❌ Delete API call FAILED - StatusCode={StatusCode}, Error={Error}", 
                        requestId, response.StatusCode, errorContent);
                    Logger.LogError("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Question deletion failed: {StatusCode} - {Error}", 
                        requestId, response.StatusCode, errorContent);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] 💥 EXCEPTION during API call: {ExceptionMessage}", requestId, ex.Message);
                Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Exception during question deletion: {ExceptionMessage}", requestId, ex.Message);
            }
        }
        else
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ❌ Invalid index - Index={Index}, Count={Count}", 
                requestId, index, Model.Questions.Count);
        }
        
        // Close modal
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Closing modal and resetting state", requestId);
        QuestionToDeleteIndex = null;
        IsModalVisible = false;
    }

    // SignalR Integration
    private async Task InitializeSignalRAsync()
    {
        try
        {
            // Dispose existing connection if any
            if (hubConnection != null)
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 Disposing existing SignalR connection");
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Disposing existing SignalR connection");
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }

            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔗 Creating SignalR hub connection to /hub/session");
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Creating SignalR hub connection to /hub/session");
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ INITIALIZING SIGNALR ════════ SessionId={SessionId}, UserGuid={UserGuid}",
                Model?.SessionId ?? 0, CurrentUserGuid);
            
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hub/session"))
                .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30) })
                .Build();

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR connection created, State={State}", hubConnection.State);

            // Connection state change events
            hubConnection.Closed += async (error) =>
            {
                Logger.LogError("[DEBUG-WORKITEM:hostcanvas:CANVAS] ❌ SignalR connection closed: {Error}", error?.Message ?? "No error");
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR connection closed: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnecting += async (error) =>
            {
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 SignalR reconnecting: {Error}", error?.Message ?? "No error");
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnecting: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnected += async (connectionId) =>
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnected with ID: {ConnectionId}", connectionId ?? "unknown");
                lastConnectionTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                
                // Re-join session after reconnection
                if (Model?.SessionId > 0)
                {
                    await hubConnection.SendAsync("JoinSession", Model.SessionId, "participant");
                    Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Re-joined session {SessionId} after reconnection", Model.SessionId);
                }
            };

            // Question events - Handle questions received from other participants
            hubConnection.On<object>("QuestionReceived", async (questionData) =>
            {
                if (Model?.Questions != null && questionData != null)
                {
                    try
                    {
                        // Parse the question data from SignalR
                        var jsonString = System.Text.Json.JsonSerializer.Serialize(questionData);
                        using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                        var root = jsonDoc.RootElement;
                        
                        var question = new QuestionData
                        {
                            QuestionId = root.TryGetProperty("questionId", out var qIdProp) ? 
                                (qIdProp.ValueKind == JsonValueKind.String ? qIdProp.GetString() ?? "" : qIdProp.GetInt32().ToString()) : "",
                            Text = root.TryGetProperty("text", out var textProp) ? textProp.GetString() ?? "" : "",
                            UserName = root.TryGetProperty("userName", out var userProp) ? userProp.GetString() ?? "Anonymous" : "Anonymous",
                            CreatedBy = root.TryGetProperty("userId", out var userIdProp) ? userIdProp.GetString() ?? "" : "",
                            Votes = root.TryGetProperty("votes", out var votesProp) ? votesProp.GetInt32() : 0,
                            CreatedAt = root.TryGetProperty("submittedAt", out var dateProp) ? dateProp.GetDateTime() : DateTime.UtcNow,
                            IsAnswered = root.TryGetProperty("isAnswered", out var answeredProp) ? answeredProp.GetBoolean() : false,
                            IsMyQuestion = root.TryGetProperty("userId", out var myUserIdProp) ? 
                                (myUserIdProp.GetString() == CurrentUserGuid) : false
                        };
                        
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:ownership] QuestionReceived - QuestionId={QuestionId}, IncomingUserId={IncomingUserId}, CurrentUserGuid={CurrentUserGuid}, IsMyQuestion={IsMyQuestion}",
                            question.QuestionId, question.CreatedBy, CurrentUserGuid, question.IsMyQuestion);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:ownership] QuestionReceived details - UserName={UserName}, Text={Text}",
                            question.UserName, question.Text?.Substring(0, Math.Min(50, question.Text?.Length ?? 0)));
                        
                        // Only add if not already in the list (prevent duplicates)
                        if (!Model.Questions.Any(q => q.QuestionId == question.QuestionId))
                        {
                            Model.Questions.Add(question);
                        }
                        
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error processing QuestionReceived event");
                    }
                }
            });

            // Handle question updates
            hubConnection.On<object>("QuestionUpdated", async (questionData) =>
            {
                var requestId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] 📝 QuestionUpdated SIGNALR EVENT RECEIVED (SessionCanvas)", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════", requestId);
                
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Current State BEFORE update:", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Model.Questions: {IsNull}", requestId, Model?.Questions == null ? "NULL" : "NOT NULL");
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Questions Count: {Count}", requestId, Model?.Questions?.Count ?? 0);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - questionData: {IsNull}", requestId, questionData == null ? "NULL" : "NOT NULL");
                    
                    if (Model?.Questions == null || questionData == null)
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ⚠️ Cannot process update - preconditions failed", requestId);
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Model.Questions is NULL: {IsNull}", requestId, Model?.Questions == null);
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - questionData is NULL: {IsNull}", requestId, questionData == null);
                        return;
                    }

                    var jsonString = System.Text.Json.JsonSerializer.Serialize(questionData);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Payload JSON: {Json}", requestId, jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    // SignalR serializes to camelCase
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var newText = root.TryGetProperty("text", out var textProp) ? textProp.GetString() : null;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Parsed payload:", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - QuestionId: {QuestionId}", requestId, questionId ?? "NULL");
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - NewText: {NewText}", requestId, newText?.Substring(0, Math.Min(50, newText?.Length ?? 0)) ?? "NULL");
                    
                    if (questionId != null)
                    {
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Searching for question in local list...", requestId);
                        
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            var oldText = question.Text;
                            question.Text = newText ?? question.Text;
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ✅ QUESTION FOUND - Updating text", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - OldText: {OldText}", requestId, oldText?.Substring(0, Math.Min(50, oldText?.Length ?? 0)));
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - NewText: {NewText}", requestId, question.Text?.Substring(0, Math.Min(50, question.Text?.Length ?? 0)));
                            
                            await InvokeAsync(StateHasChanged);
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Current State AFTER update:", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Questions Count: {Count}", requestId, Model.Questions.Count);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ✅ SessionCanvas UI updated successfully", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas:signalr] Question updated via SignalR: {QuestionId}", questionId);
                        }
                        else
                        {
                            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ❌ QUESTION NOT FOUND in SessionCanvas.Questions", requestId);
                            Logger.LogDebug("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Available Question IDs: {QuestionIds}", 
                                requestId, string.Join(", ", Model.Questions.Select(q => q.QuestionId)));
                        }
                    }
                    else
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ⚠️ QuestionId is NULL in payload", requestId);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] 💥 EXCEPTION processing QuestionUpdated: {Message}", requestId, ex.Message);
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - StackTrace: {StackTrace}", requestId, ex.StackTrace);
                }
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] SessionCanvas QuestionUpdated handler COMPLETE", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════", requestId);
            });

            hubConnection.On<string, int>("QuestionVoteUpdated", async (questionId, newVoteCount) =>
            {
                Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] QuestionVoteUpdated received - QuestionId={QuestionId}, NewVoteCount={NewVoteCount}", 
                    questionId, newVoteCount);
                
                Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR QuestionVoteUpdated - QuestionId={QuestionId}, NewVoteCount={NewVoteCount}", 
                    questionId, newVoteCount);
                
                if (Model?.Questions != null)
                {
                    var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                    if (question != null)
                    {
                        Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] Updating question votes - OldVotes={OldVotes}, NewVotes={NewVotes}", 
                            question.Votes, newVoteCount);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] Vote count UPDATE - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes}", 
                            questionId, question.Votes, newVoteCount);
                        
                        question.Votes = newVoteCount;
                        await InvokeAsync(StateHasChanged);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] UI refreshed with new vote count - QuestionId={QuestionId}, Votes={Votes}", 
                            questionId, newVoteCount);
                    }
                    else
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:use-questions:signalr] Question not found for vote update: {QuestionId}", questionId);
                    }
                }
            });

            // Also handle QuestionVoteUpdate (without "d") event from API
            hubConnection.On<object>("QuestionVoteUpdate", async (voteData) =>
            {
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ SIGNALR RECEIVED QuestionVoteUpdate ════════");
                
                try
                {
                    var jsonString = System.Text.Json.JsonSerializer.Serialize(voteData);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR payload: {Payload}", jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var votes = root.TryGetProperty("votes", out var votesProp) ? votesProp.GetInt32() : 0;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Parsed - QuestionId={QuestionId}, NewVotes={Votes}", 
                        questionId, votes);
                    
                    Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] QuestionVoteUpdate received - QuestionId={QuestionId}, Votes={Votes}", 
                        questionId, votes);
                    
                    Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR QuestionVoteUpdate (API format) - QuestionId={QuestionId}, Votes={Votes}", 
                        questionId, votes);
                    
                    if (Model?.Questions != null && questionId != null)
                    {
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Searching for question in Model.Questions, Total={Total}", 
                            Model.Questions.Count);
                        
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            var oldVotes = question.Votes;
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] UPDATING VOTE COUNT - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes}", 
                                questionId, oldVotes, votes);
                            
                            Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] Vote count UPDATE (API format) - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes}", 
                                questionId, question.Votes, votes);
                            
