    /// <summary>
    /// [DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] Debug Actions Factory for HostLanding ;CLEANUP_OK
    /// </summary>
    private List<NoorCanvas.Models.Debug.IDebugAction> GetHostLandingDebugActions()
    {
        var requestId = Guid.NewGuid().ToString("N")[..8];
        Logger.LogInformation("[DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] [{RequestId}] Creating debug actions for HostLanding ;CLEANUP_OK", requestId);
        
        var actions = new List<NoorCanvas.Models.Debug.IDebugAction>();
        
        // Action 1: Auto-fill with test token
        if (Model != null && string.IsNullOrEmpty(Model.FriendlyToken))
        {
            Logger.LogInformation("[DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] [{RequestId}] Adding 'Enter Test Token' action ;CLEANUP_OK", requestId);
            
            actions.Add(new NoorCanvas.Models.Debug.DebugAction(
                "Enter Test Token",
                "Auto-fill with session 212 host token (TESTHOST)",
                async () => await HandleEnterTestToken(),
                "fa-solid fa-key"
            )
            {
                IsEnabled = !isLoading
            });
        }
        
        // Action 2: Quick authenticate (if token already entered)
        if (Model != null && !string.IsNullOrEmpty(Model.FriendlyToken))
        {
            Logger.LogInformation("[DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] [{RequestId}] Adding 'Quick Authenticate' action ;CLEANUP_OK", requestId);
            
            actions.Add(new NoorCanvas.Models.Debug.DebugAction(
                "Quick Authenticate",
                "Immediately authenticate with current token",
                async () => await HandleAuthentication(),
                "fa-solid fa-bolt"
            )
            {
                IsEnabled = !isLoading && Model.FriendlyToken.Length == 8
            });
        }
        
        // Action 3: Clean Canvas Database [DIAGNOSTIC:debug-panel:clean-canvas] ;CLEANUP_OK
        Logger.LogInformation("[DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] [{RequestId}] Adding 'Clean Canvas DB' action ;CLEANUP_OK", requestId);
        
        actions.Add(new NoorCanvas.Models.Debug.DebugAction(
            "Clean Canvas DB",
            "Execute canvas.CleanCanvas stored procedure to reset test data",
            async () => await HandleCleanCanvasDatabase(),
            "fa-solid fa-broom"
        )
        {
            IsEnabled = !isLoading
        });
        
        Logger.LogInformation("[DEBUG-WORKITEM:debug-panel:hostlanding:TRACE] [{RequestId}] Created {Count} debug actions ;CLEANUP_OK", requestId, actions.Count);
        
        return actions;
    }
    
