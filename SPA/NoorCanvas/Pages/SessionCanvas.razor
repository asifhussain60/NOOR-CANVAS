    // SignalR Integration
    private async Task InitializeSignalRAsync()
    {
        try
        {
            // Dispose existing connection if any
            if (hubConnection != null)
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 Disposing existing SignalR connection");
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Disposing existing SignalR connection");
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }

            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔗 Creating SignalR hub connection to /hub/session");
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Creating SignalR hub connection to /hub/session");
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ INITIALIZING SIGNALR ════════ SessionId={SessionId}, UserGuid={UserGuid} ;CLEANUP_OK",
                Model?.SessionId ?? 0, CurrentUserGuid);
            
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hub/session"))
                .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30) })
                .Build();

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR connection created, State={State} ;CLEANUP_OK", hubConnection.State);

            // Connection state change events
            hubConnection.Closed += async (error) =>
            {
                Logger.LogError("[DEBUG-WORKITEM:hostcanvas:CANVAS] ❌ SignalR connection closed: {Error}", error?.Message ?? "No error");
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR connection closed: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnecting += async (error) =>
            {
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 SignalR reconnecting: {Error}", error?.Message ?? "No error");
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnecting: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnected += async (connectionId) =>
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnected with ID: {ConnectionId}", connectionId ?? "unknown");
                lastConnectionTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                
                // Re-join session after reconnection
                if (Model?.SessionId > 0)
                {
                    await hubConnection.SendAsync("JoinSession", Model.SessionId, "participant");
                    Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Re-joined session {SessionId} after reconnection", Model.SessionId);
                }
            };

            // Question events - Handle questions received from other participants
            hubConnection.On<object>("QuestionReceived", async (questionData) =>
            {
                if (Model?.Questions != null && questionData != null)
                {
                    try
                    {
                        // Parse the question data from SignalR
                        var jsonString = System.Text.Json.JsonSerializer.Serialize(questionData);
                        using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                        var root = jsonDoc.RootElement;
                        
                        var question = new QuestionData
                        {
                            QuestionId = root.TryGetProperty("questionId", out var qIdProp) ? 
                                (qIdProp.ValueKind == JsonValueKind.String ? qIdProp.GetString() ?? "" : qIdProp.GetInt32().ToString()) : "",
                            Text = root.TryGetProperty("text", out var textProp) ? textProp.GetString() ?? "" : "",
                            UserName = root.TryGetProperty("userName", out var userProp) ? userProp.GetString() ?? "Anonymous" : "Anonymous",
                            CreatedBy = root.TryGetProperty("userId", out var userIdProp) ? userIdProp.GetString() ?? "" : "",
                            Votes = root.TryGetProperty("votes", out var votesProp) ? votesProp.GetInt32() : 0,
                            CreatedAt = root.TryGetProperty("submittedAt", out var dateProp) ? dateProp.GetDateTime() : DateTime.UtcNow,
                            IsAnswered = root.TryGetProperty("isAnswered", out var answeredProp) ? answeredProp.GetBoolean() : false,
                            IsMyQuestion = root.TryGetProperty("userId", out var myUserIdProp) ? 
                                (myUserIdProp.GetString() == CurrentUserGuid) : false
                        };
                        
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:ownership] QuestionReceived - QuestionId={QuestionId}, IncomingUserId={IncomingUserId}, CurrentUserGuid={CurrentUserGuid}, IsMyQuestion={IsMyQuestion} ;CLEANUP_OK",
                            question.QuestionId, question.CreatedBy, CurrentUserGuid, question.IsMyQuestion);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:ownership] QuestionReceived details - UserName={UserName}, Text={Text} ;CLEANUP_OK",
                            question.UserName, question.Text?.Substring(0, Math.Min(50, question.Text?.Length ?? 0)));
                        
                        // Only add if not already in the list (prevent duplicates)
                        if (!Model.Questions.Any(q => q.QuestionId == question.QuestionId))
                        {
                            Model.Questions.Add(question);
                        }
                        
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error processing QuestionReceived event");
                    }
                }
            });

            // Handle question updates
            hubConnection.On<object>("QuestionUpdated", async (questionData) =>
            {
                var requestId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] 📝 QuestionUpdated SIGNALR EVENT RECEIVED (SessionCanvas) ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Current State BEFORE update: ;CLEANUP_OK", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Model.Questions: {IsNull} ;CLEANUP_OK", requestId, Model?.Questions == null ? "NULL" : "NOT NULL");
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Questions Count: {Count} ;CLEANUP_OK", requestId, Model?.Questions?.Count ?? 0);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - questionData: {IsNull} ;CLEANUP_OK", requestId, questionData == null ? "NULL" : "NOT NULL");
                    
                    if (Model?.Questions == null || questionData == null)
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ⚠️ Cannot process update - preconditions failed ;CLEANUP_OK", requestId);
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Model.Questions is NULL: {IsNull} ;CLEANUP_OK", requestId, Model?.Questions == null);
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - questionData is NULL: {IsNull} ;CLEANUP_OK", requestId, questionData == null);
                        return;
                    }

                    var jsonString = System.Text.Json.JsonSerializer.Serialize(questionData);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Payload JSON: {Json} ;CLEANUP_OK", requestId, jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    // SignalR serializes to camelCase
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var newText = root.TryGetProperty("text", out var textProp) ? textProp.GetString() : null;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Parsed payload: ;CLEANUP_OK", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - QuestionId: {QuestionId} ;CLEANUP_OK", requestId, questionId ?? "NULL");
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - NewText: {NewText} ;CLEANUP_OK", requestId, newText?.Substring(0, Math.Min(50, newText?.Length ?? 0)) ?? "NULL");
                    
                    if (questionId != null)
                    {
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Searching for question in local list... ;CLEANUP_OK", requestId);
                        
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            var oldText = question.Text;
                            question.Text = newText ?? question.Text;
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ✅ QUESTION FOUND - Updating text ;CLEANUP_OK", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - OldText: {OldText} ;CLEANUP_OK", requestId, oldText?.Substring(0, Math.Min(50, oldText?.Length ?? 0)));
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - NewText: {NewText} ;CLEANUP_OK", requestId, question.Text?.Substring(0, Math.Min(50, question.Text?.Length ?? 0)));
                            
                            await InvokeAsync(StateHasChanged);
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Current State AFTER update: ;CLEANUP_OK", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - Questions Count: {Count} ;CLEANUP_OK", requestId, Model.Questions.Count);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ✅ SessionCanvas UI updated successfully ;CLEANUP_OK", requestId);
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas:signalr] Question updated via SignalR: {QuestionId} ;CLEANUP_OK", questionId);
                        }
                        else
                        {
                            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ❌ QUESTION NOT FOUND in SessionCanvas.Questions ;CLEANUP_OK", requestId);
                            Logger.LogDebug("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] Available Question IDs: {QuestionIds} ;CLEANUP_OK", 
                                requestId, string.Join(", ", Model.Questions.Select(q => q.QuestionId)));
                        }
                    }
                    else
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ⚠️ QuestionId is NULL in payload ;CLEANUP_OK", requestId);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] 💥 EXCEPTION processing QuestionUpdated: {Message} ;CLEANUP_OK", requestId, ex.Message);
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}]   - StackTrace: {StackTrace} ;CLEANUP_OK", requestId, ex.StackTrace);
                }
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] SessionCanvas QuestionUpdated handler COMPLETE ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
            });

            hubConnection.On<string, int>("QuestionVoteUpdated", async (questionId, newVoteCount) =>
            {
                Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] QuestionVoteUpdated received - QuestionId={QuestionId}, NewVoteCount={NewVoteCount} ;CLEANUP_OK", 
                    questionId, newVoteCount);
                
                Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR QuestionVoteUpdated - QuestionId={QuestionId}, NewVoteCount={NewVoteCount} ;CLEANUP_OK", 
                    questionId, newVoteCount);
                
                if (Model?.Questions != null)
                {
                    var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                    if (question != null)
                    {
                        Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] Updating question votes - OldVotes={OldVotes}, NewVotes={NewVotes} ;CLEANUP_OK", 
                            question.Votes, newVoteCount);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] Vote count UPDATE - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes} ;CLEANUP_OK", 
                            questionId, question.Votes, newVoteCount);
                        
                        question.Votes = newVoteCount;
                        await InvokeAsync(StateHasChanged);
                        
                        Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] UI refreshed with new vote count - QuestionId={QuestionId}, Votes={Votes} ;CLEANUP_OK", 
                            questionId, newVoteCount);
                    }
                    else
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:use-questions:signalr] Question not found for vote update: {QuestionId} ;CLEANUP_OK", questionId);
                    }
                }
            });

            // Also handle QuestionVoteUpdate (without "d") event from API
            hubConnection.On<object>("QuestionVoteUpdate", async (voteData) =>
            {
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ SIGNALR RECEIVED QuestionVoteUpdate ════════ ;CLEANUP_OK");
                
                try
                {
                    var jsonString = System.Text.Json.JsonSerializer.Serialize(voteData);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR payload: {Payload} ;CLEANUP_OK", jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var votes = root.TryGetProperty("votes", out var votesProp) ? votesProp.GetInt32() : 0;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Parsed - QuestionId={QuestionId}, NewVotes={Votes} ;CLEANUP_OK", 
                        questionId, votes);
                    
                    Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] QuestionVoteUpdate received - QuestionId={QuestionId}, Votes={Votes} ;CLEANUP_OK", 
                        questionId, votes);
                    
                    Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR QuestionVoteUpdate (API format) - QuestionId={QuestionId}, Votes={Votes} ;CLEANUP_OK", 
                        questionId, votes);
                    
                    if (Model?.Questions != null && questionId != null)
                    {
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Searching for question in Model.Questions, Total={Total} ;CLEANUP_OK", 
                            Model.Questions.Count);
                        
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            var oldVotes = question.Votes;
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] UPDATING VOTE COUNT - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes} ;CLEANUP_OK", 
                                questionId, oldVotes, votes);
                            
                            Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] Vote count UPDATE (API format) - QuestionId={QuestionId}, OldVotes={OldVotes}, NewVotes={NewVotes} ;CLEANUP_OK", 
                                questionId, question.Votes, votes);
                            
                            question.Votes = votes;
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Calling StateHasChanged to refresh UI ;CLEANUP_OK");
                            await InvokeAsync(StateHasChanged);
                            
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ✅ UI UPDATED - Question {QuestionId} now shows {Votes} votes ;CLEANUP_OK", 
                                questionId, votes);
                            
                            Logger.LogTrace("[DEBUG-WORKITEM:canvas-questions:upvote] UI refreshed with new vote count (API format) - QuestionId={QuestionId}, Votes={Votes} ;CLEANUP_OK", 
                                questionId, votes);
                        }
                        else
                        {
                            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:upvote] ❌ QUESTION NOT FOUND in Model.Questions - QuestionId={QuestionId}, TotalQuestions={Total} ;CLEANUP_OK", 
                                questionId, Model.Questions.Count);
                            
                            // Log all question IDs for debugging
                            var allIds = string.Join(", ", Model.Questions.Select(q => q.QuestionId.Substring(0, 8)));
                            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:upvote] Available QuestionIds: {Ids} ;CLEANUP_OK", allIds);
                        }
                    }
                    else
                    {
                        Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:upvote] ❌ Model.Questions is null or QuestionId is null - Questions={QuestionsNull}, QuestionId={QuestionId} ;CLEANUP_OK", 
                            Model?.Questions == null, questionId ?? "NULL");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:upvote] ❌ EXCEPTION in SignalR handler: {Message} ;CLEANUP_OK", ex.Message);
                    Logger.LogError(ex, "[DEBUG-WORKITEM:use-questions:signalr] Error processing QuestionVoteUpdate: {Message} ;CLEANUP_OK", ex.Message);
                }
            });

            // [FIX-ISSUE-2] Handle question being marked as answered by host
            hubConnection.On<object>("QuestionAnswered", async (answerData) =>
            {
                var requestId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ✅ QuestionAnswered SIGNALR EVENT RECEIVED (SessionCanvas) ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                
                try
                {
                    var jsonString = System.Text.Json.JsonSerializer.Serialize(answerData);
                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Payload JSON: {Json} ;CLEANUP_OK", requestId, jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var originalAskerGuid = root.TryGetProperty("originalAskerGuid", out var askerProp) ? askerProp.GetString() : null;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Parsed - QuestionId={QuestionId}, OriginalAsker={Asker}, CurrentUserGuid={CurrentUser} ;CLEANUP_OK", 
                        requestId, questionId ?? "NULL", originalAskerGuid ?? "NULL", CurrentUserGuid);
                    
                    if (Model?.Questions != null && questionId != null)
                    {
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            // Remove from participant list
                            Model.Questions.Remove(question);
                            
                            // Show toast if THIS user asked the question
                            if (!string.IsNullOrEmpty(CurrentUserGuid) && !string.IsNullOrEmpty(originalAskerGuid) && CurrentUserGuid == originalAskerGuid)
                            {
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] 🎉 THIS USER asked the question - showing success toast ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 📢 TOAST INVOCATION START (QuestionAnswered) ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - CurrentUserGuid: '{CurrentUser}' ;CLEANUP_OK", requestId, CurrentUserGuid);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - OriginalAskerGuid: '{AskerGuid}' ;CLEANUP_OK", requestId, originalAskerGuid);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - GUIDs Match: TRUE ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - About to call JSRuntime.InvokeVoidAsync('showNoorToast', ...) ;CLEANUP_OK", requestId);
                                
                                try
                                {
                                    await JSRuntime.InvokeVoidAsync("showNoorToast", 
                                        "The host has addressed your question during the session.", 
                                        "Question Answered", 
                                        "success");
                                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ✅ JSRuntime.InvokeVoidAsync completed successfully ;CLEANUP_OK", requestId);
                                }
                                catch (Exception toastEx)
                                {
                                    Logger.LogError(toastEx, "[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 💥 JSRuntime.InvokeVoidAsync FAILED: {Message} ;CLEANUP_OK", requestId, toastEx.Message);
                                }
                                
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 📢 TOAST INVOCATION END ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                            }
                            else
                            {
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Different user asked question - no toast shown ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 🚫 TOAST NOT SHOWN (QuestionAnswered) ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - CurrentUserGuid: '{CurrentUser}' ;CLEANUP_OK", requestId, CurrentUserGuid ?? "NULL");
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - OriginalAskerGuid: '{AskerGuid}' ;CLEANUP_OK", requestId, originalAskerGuid ?? "NULL");
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - GUIDs Match: FALSE ;CLEANUP_OK", requestId);
                            }
                            
                            await InvokeAsync(StateHasChanged);
                            Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ✅ Question {QuestionId} removed from participant view ;CLEANUP_OK", requestId, questionId);
                        }
                        else
                        {
                            Logger.LogWarning("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Question not found in local list ;CLEANUP_OK", requestId);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] 💥 Error processing QuestionAnswered: {Message} ;CLEANUP_OK", requestId, ex.Message);
                }
                
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] SessionCanvas QuestionAnswered handler COMPLETE ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
            });

            // Handle question deletion
            hubConnection.On<object>("QuestionDeleted", async (deleteData) =>
            {
                var requestId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] 🗑️ QuestionDeleted SIGNALR EVENT RECEIVED (SessionCanvas) ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] Current State BEFORE deletion: ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - Model.Questions: {IsNull} ;CLEANUP_OK", requestId, Model?.Questions == null ? "NULL" : "NOT NULL");
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - Questions Count: {Count} ;CLEANUP_OK", requestId, Model?.Questions?.Count ?? 0);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - deleteData: {IsNull} ;CLEANUP_OK", requestId, deleteData == null ? "NULL" : "NOT NULL");
                
                if (Model?.Questions != null && deleteData != null)
                {
                    try
                    {
                        var jsonString = System.Text.Json.JsonSerializer.Serialize(deleteData);
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] Payload JSON: {Json} ;CLEANUP_OK", requestId, jsonString);
                        
                        using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                        var root = jsonDoc.RootElement;
                        
                        // SignalR serializes to camelCase, so use "questionId" not "QuestionId"
                        var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                        var sessionId = root.TryGetProperty("sessionId", out var sIdProp) ? sIdProp.GetInt32() : 0;
                        var originalAskerGuid = root.TryGetProperty("originalAskerGuid", out var askerProp) ? askerProp.GetString() : null;  // [FIX-ISSUE-3] Extract for toast targeting
                        var deletedBy = root.TryGetProperty("deletedBy", out var deletedByProp) ? deletedByProp.GetString() : null;  // [FIX-ISSUE-3] Determine who deleted it
                        
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] Parsed payload: ;CLEANUP_OK", requestId);
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - QuestionId: {QuestionId} ;CLEANUP_OK", requestId, questionId ?? "NULL");
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - SessionId: {SessionId} ;CLEANUP_OK", requestId, sessionId);
                        Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:delete] [{RequestId}]   - OriginalAskerGuid: {AskerGuid} ;CLEANUP_OK", requestId, originalAskerGuid ?? "NULL");
                        Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:delete] [{RequestId}]   - DeletedBy: {DeletedBy} ;CLEANUP_OK", requestId, deletedBy ?? "NULL");
                        
                        if (questionId != null)
                        {
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] Searching for question in local list... ;CLEANUP_OK", requestId);
                            
                            var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                            if (question != null)
                            {
                                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}] ✅ QUESTION FOUND - Removing from UI ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - Question Text: '{Text}' ;CLEANUP_OK", requestId, question.Text);
                                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete:TRACE] [{RequestId}]   - Question User: '{UserName}' ;CLEANUP_OK", requestId, question.UserName);
                                
                                Model.Questions.Remove(question);
                                
                                // [FIX-ISSUE-3] Show toast if THIS user asked the question that was deleted by host
                                if (!string.IsNullOrEmpty(CurrentUserGuid) && !string.IsNullOrEmpty(originalAskerGuid) && CurrentUserGuid == originalAskerGuid)
