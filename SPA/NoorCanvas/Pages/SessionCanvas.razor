    private async Task RetrySignalRConnection()
    {
        var diagId = Guid.NewGuid().ToString("N")[..8];
        Logger.LogInformation("SIGNALR-DIAG: [SC-RetrySignalRConnection] START - DiagId={DiagId}", diagId);
        
        try
        {
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Retrying SignalR connection...");
            
            if (hubConnection != null)
            {
                Logger.LogInformation("SIGNALR-DIAG: [SC-RetrySignalRConnection] Disposing existing connection - DiagId={DiagId}", diagId);
                await hubConnection.DisposeAsync();
            }
            
            await InitializeSignalRAsync();
            StateHasChanged();
            
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR connection retry completed");
            Logger.LogInformation("SIGNALR-DIAG: [SC-RetrySignalRConnection] COMPLETE - DiagId={DiagId}", diagId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:hostcanvas:CANVAS] Failed to retry SignalR connection");
            Logger.LogError("SIGNALR-DIAG: [SC-RetrySignalRConnection] ERROR - Message={Message}, DiagId={DiagId}",
                ex.Message, diagId);
        }
    }

