    /// <summary>
    /// Safely process HTML content using unified transformation service
    /// [DEBUG-WORKITEM:signalcomm:impl] Enhanced with UnifiedHtmlTransformService for consistent transformation ;CLEANUP_OK
    /// </summary>
    private string GetSafeHtmlContent(string? htmlContent)
    {
        if (string.IsNullOrEmpty(htmlContent))
            return string.Empty;

        try
        {
            // Use unified transformation service for participant view (safe rendering only)
            var transformedHtml = HtmlTransform.TransformForParticipant(htmlContent);
            
            Logger.LogInformation("[DEBUG-WORKITEM:signalcomm:impl] HTML transformed successfully by unified service, length: {Length} ;CLEANUP_OK", 
                transformedHtml?.Length ?? 0);

            return transformedHtml ?? string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:signalcomm:impl] Error in unified HTML transformation ;CLEANUP_OK");
            return CreateSafeErrorMessage($"Transformation error: {ex.Message}");
        }
    }

    /// <summary>
    /// Create a safe error message in HTML format
    /// </summary>
    private string CreateSafeErrorMessage(string message)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        return $@"<div style=""background:#FEF2F2;color:#DC2626;padding:15px;border-radius:8px;border:1px solid #FCA5A5;text-align:center;"">
<h4 style=""margin:0 0 8px 0;"">⚠️ Content Error</h4>
<p style=""margin:0;font-size:14px;"">{System.Web.HttpUtility.HtmlEncode(message)}</p>
<p style=""margin:8px 0 0 0;font-size:12px;opacity:0.8;"">Time: {timestamp} (Advanced Parser)</p>
</div>";
    }

