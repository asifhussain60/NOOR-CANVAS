    private async Task DeleteConfirmed()
    {
        var requestId = Guid.NewGuid().ToString("N")[..8];
        
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ════════ DELETE CONFIRMED ════════ ;CLEANUP_OK", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Current state: ;CLEANUP_OK", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - Http: {HttpNull} ;CLEANUP_OK", requestId, Http == null);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - QuestionToDeleteIndex: {Index} ;CLEANUP_OK", requestId, QuestionToDeleteIndex);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - Model.Questions: {QuestionsNull} ;CLEANUP_OK", requestId, Model?.Questions == null);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - Questions Count: {Count} ;CLEANUP_OK", requestId, Model?.Questions?.Count ?? 0);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - SessionToken: {Token} ;CLEANUP_OK", requestId, SessionToken ?? "NULL");
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - CurrentUserGuid: {UserGuid} ;CLEANUP_OK", requestId, CurrentUserGuid ?? "NULL");
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - HubConnection State: {State} ;CLEANUP_OK", requestId, hubConnection?.State.ToString() ?? "NULL");
        
        if (Http == null || QuestionToDeleteIndex == null || Model?.Questions == null)
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ❌ Invalid delete state - aborting ;CLEANUP_OK", requestId);
            Logger.LogWarning("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Invalid delete state ;CLEANUP_OK", requestId);
            IsModalVisible = false;
            return;
        }
        
        var index = QuestionToDeleteIndex.Value;
        if (index >= 0 && index < Model.Questions.Count)
        {
            var questionToDelete = Model.Questions[index];
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Preparing API call: ;CLEANUP_OK", requestId);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - QuestionId: {QuestionId} ;CLEANUP_OK", requestId, questionToDelete.QuestionId);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}]   - API Endpoint: /api/Question/{QuestionId}/delete ;CLEANUP_OK", requestId, questionToDelete.QuestionId);
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Deleting question - QuestionId: {QuestionId} ;CLEANUP_OK", 
                requestId, questionToDelete.QuestionId);

            try
            {
                var requestPayload = new
                {
                    SessionToken = SessionToken,
                    UserGuid = CurrentUserGuid
                };

                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Sending DELETE request... ;CLEANUP_OK", requestId);
                var response = await Http.PostAsJsonAsync($"/api/Question/{questionToDelete.QuestionId}/delete", requestPayload);

                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] API response received - StatusCode={StatusCode} ({StatusCodeInt}) ;CLEANUP_OK", 
                    requestId, response.StatusCode, (int)response.StatusCode);
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] API response received - StatusCode: {StatusCode} ;CLEANUP_OK", requestId, response.StatusCode);

                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync();
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ✅ Delete API call SUCCESS - Response: {Response} ;CLEANUP_OK", 
                        requestId, responseContent);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Waiting for SignalR QuestionDeleted event to update UI... ;CLEANUP_OK", requestId);
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Question deleted successfully ;CLEANUP_OK", requestId);
                    // Question will be removed from UI via SignalR notification
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ❌ Delete API call FAILED - StatusCode={StatusCode}, Error={Error} ;CLEANUP_OK", 
                        requestId, response.StatusCode, errorContent);
                    Logger.LogError("[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Question deletion failed: {StatusCode} - {Error} ;CLEANUP_OK", 
                        requestId, response.StatusCode, errorContent);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] 💥 EXCEPTION during API call: {ExceptionMessage} ;CLEANUP_OK", requestId, ex.Message);
                Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:delete] [{RequestId}] Exception during question deletion: {ExceptionMessage} ;CLEANUP_OK", requestId, ex.Message);
            }
        }
        else
        {
            Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] ❌ Invalid index - Index={Index}, Count={Count} ;CLEANUP_OK", 
                requestId, index, Model.Questions.Count);
        }
        
        // Close modal
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:delete] [{RequestId}] Closing modal and resetting state ;CLEANUP_OK", requestId);
        QuestionToDeleteIndex = null;
        IsModalVisible = false;
    }

    // SignalR Integration
    // [REFACTOR:Phase3] Refactored to use SignalRMiddleware + ISessionCanvasSignalRService
    private async Task InitializeSignalRAsync()
    {
        var diagId = Guid.NewGuid().ToString("N")[..8];
        Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] START - SessionId={SessionId}, UserGuid={UserGuid}, DiagId={DiagId}",
            Model?.SessionId ?? 0, CurrentUserGuid, diagId);
        
        try
        {
            // [REFACTOR:Phase3] Dispose existing connection if any
            if (hubConnection != null)
            {
                Logger.LogInformation("[REFACTOR:Phase3] Disposing existing SignalR connection");
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }

            // [REFACTOR:Phase3] Use SignalRMiddleware for managed connection
            Logger.LogInformation("[REFACTOR:Phase3] Creating managed SignalR connection via SignalRMiddleware for /hub/session");
            Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] About to call GetOrCreateConnectionAsync - DiagId={DiagId}", diagId);
            
            try
            {
                hubConnection = await SignalRService.GetOrCreateConnectionAsync("/hub/session");
                Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] GetOrCreateConnectionAsync returned - State={State}, ConnectionId={ConnectionId}, DiagId={DiagId}", 
                    hubConnection?.State ?? HubConnectionState.Disconnected, 
                    hubConnection?.ConnectionId ?? "NULL", 
                    diagId);
            }
            catch (Exception connEx)
            {
                Logger.LogError(connEx, "SIGNALR-DIAG: [SC-InitializeSignalRAsync] ❌ CRITICAL FAILURE in GetOrCreateConnectionAsync - Message={Message}, DiagId={DiagId}", 
                    connEx.Message, diagId);
                throw; // Re-throw to outer catch
            }

            if (hubConnection == null)
            {
                Logger.LogError("SIGNALR-DIAG: [SC-InitializeSignalRAsync] ❌ CRITICAL: hubConnection is NULL after GetOrCreateConnectionAsync - DiagId={DiagId}", diagId);
                throw new InvalidOperationException("SignalR connection was not created by SignalRMiddleware");
            }

            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] SignalR connection created, State={State} ;CLEANUP_OK", hubConnection.State);
            Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] HubConnection created with auto-reconnect, registering event handlers - DiagId={DiagId}", diagId);

            // Connection state change events
            hubConnection.Closed += async (error) =>
            {
                Logger.LogError("[DEBUG-WORKITEM:hostcanvas:CANVAS] ❌ SignalR connection closed: {Error}", error?.Message ?? "No error");
                Logger.LogError("SIGNALR-DIAG: [SC-Closed] Connection closed - Error={Error}, DiagId={DiagId}",
                    error?.Message ?? "No error", diagId);
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR connection closed: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnecting += async (error) =>
            {
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 SignalR reconnecting: {Error}", error?.Message ?? "No error");
                Logger.LogWarning("SIGNALR-DIAG: [SC-Reconnecting] Connection reconnecting - Error={Error}, DiagId={DiagId}",
                    error?.Message ?? "No error", diagId);
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnecting: {Error}", error?.Message ?? "No error");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnected += async (connectionId) =>
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR reconnected with ID: {ConnectionId}", connectionId ?? "unknown");
                Logger.LogInformation("SIGNALR-DIAG: [SC-Reconnected] Connection re-established - ConnectionId={ConnectionId}, DiagId={DiagId}",
                    connectionId ?? "unknown", diagId);
                lastConnectionTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                
                // Re-join session after reconnection
                if (Model?.SessionId > 0)
                {
                    await hubConnection.SendAsync("JoinSession", Model.SessionId, "participant");
                    Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Re-joined session {SessionId} after reconnection", Model.SessionId);
                    Logger.LogInformation("SIGNALR-DIAG: [SC-Reconnected] Re-joined session - SessionId={SessionId}, DiagId={DiagId}",
                        Model.SessionId, diagId);
                }
            };

            hubConnection.On<object>("QuestionReceived", async (data) => 
                await SignalREventService.HandleQuestionReceivedAsync(data, OnQuestionAdded));
            
            hubConnection.On<object>("QuestionUpdated", async (data) => 
                await SignalREventService.HandleQuestionUpdatedAsync(data, OnQuestionUpdated));
            
            hubConnection.On<object>("QuestionVoteUpdate", async (data) => 
                await SignalREventService.HandleVoteUpdateAsync(data, OnVoteUpdated));
            
            hubConnection.On<object>("QuestionDeleted", async (data) => 
                await SignalREventService.HandleQuestionDeletedAsync(data, OnQuestionDeleted));
            
            hubConnection.On<object>("AssetShared", async (data) => 
                await SignalREventService.HandleAssetSharedAsync(data, OnAssetShared));
            
            hubConnection.On<object>("SessionEnded", async (data) => 
                await SignalREventService.HandleSessionEndedAsync(data, OnSessionEnded));
            
            // NEW: AssetContentReceived from PublishAssetContent (KSESSIONS pattern)
            Logger.LogInformation("[DEBUG-BROADCAST] SESSIONCANVAS: Registering AssetContentReceived handler");
            hubConnection.On<string>("AssetContentReceived", async (htmlContent) =>
            {
                var eventId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] ════════════════════════════════════════", eventId);
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] SESSIONCANVAS: AssetContentReceived EVENT FIRED", eventId);
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] SESSIONCANVAS: htmlContent length={Length}", eventId, htmlContent?.Length ?? 0);
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] SESSIONCANVAS: Calling SignalREventService.HandleAssetContentReceivedAsync...", eventId);
                
                await SignalREventService.HandleAssetContentReceivedAsync(htmlContent, OnAssetShared);
                
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] SESSIONCANVAS: ✅ Handler completed", eventId);
                Logger.LogInformation("[DEBUG-BROADCAST:{EventId}] ════════════════════════════════════════", eventId);
            });

            hubConnection.On<string, int>("QuestionVoteUpdated", async (questionId, newVoteCount) =>
            {
                Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] QuestionVoteUpdated received - QuestionId={QuestionId}, NewVoteCount={NewVoteCount} ;CLEANUP_OK", 
                    questionId, newVoteCount);
                
                if (Model?.Questions != null)
                {
                    var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                    if (question != null)
                    {
                        Logger.LogDebug("[DEBUG-WORKITEM:use-questions:signalr] Updating question votes - OldVotes={OldVotes}, NewVotes={NewVotes} ;CLEANUP_OK", 
                            question.Votes, newVoteCount);
                        
                        question.Votes = newVoteCount;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            });

            hubConnection.On<object>("QuestionAnswered", async (answerData) =>
            {
                var requestId = Guid.NewGuid().ToString("N")[..8];
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ✅ QuestionAnswered SIGNALR EVENT RECEIVED (SessionCanvas) ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                
                try
                {
                    var jsonString = System.Text.Json.JsonSerializer.Serialize(answerData);
                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Payload JSON: {Json} ;CLEANUP_OK", requestId, jsonString);
                    
                    using var jsonDoc = System.Text.Json.JsonDocument.Parse(jsonString);
                    var root = jsonDoc.RootElement;
                    
                    var questionId = root.TryGetProperty("questionId", out var qIdProp) ? qIdProp.GetString() : null;
                    var originalAskerGuid = root.TryGetProperty("originalAskerGuid", out var askerProp) ? askerProp.GetString() : null;
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Parsed - QuestionId={QuestionId}, OriginalAsker={Asker}, CurrentUserGuid={CurrentUser} ;CLEANUP_OK", 
                        requestId, questionId ?? "NULL", originalAskerGuid ?? "NULL", CurrentUserGuid);
                    
                    if (Model?.Questions != null && questionId != null)
                    {
                        var question = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
                        if (question != null)
                        {
                            // Remove from participant list
                            Model.Questions.Remove(question);
                            
                            // Show toast if THIS user asked the question
                            if (!string.IsNullOrEmpty(CurrentUserGuid) && !string.IsNullOrEmpty(originalAskerGuid) && CurrentUserGuid == originalAskerGuid)
                            {
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] 🎉 THIS USER asked the question - showing success toast ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 📢 TOAST INVOCATION START (QuestionAnswered) ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - CurrentUserGuid: '{CurrentUser}' ;CLEANUP_OK", requestId, CurrentUserGuid);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - OriginalAskerGuid: '{AskerGuid}' ;CLEANUP_OK", requestId, originalAskerGuid);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - GUIDs Match: TRUE ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - About to call JSRuntime.InvokeVoidAsync('showNoorToast', ...) ;CLEANUP_OK", requestId);
                                
                                try
                                {
                                    await JSRuntime.InvokeVoidAsync("showNoorToast", 
                                        "The host has addressed your question during the session.", 
                                        "Question Answered", 
                                        "success");
                                    Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ✅ JSRuntime.InvokeVoidAsync completed successfully ;CLEANUP_OK", requestId);
                                }
                                catch (Exception toastEx)
                                {
                                    Logger.LogError(toastEx, "[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 💥 JSRuntime.InvokeVoidAsync FAILED: {Message} ;CLEANUP_OK", requestId, toastEx.Message);
                                }
                                
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 📢 TOAST INVOCATION END ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                            }
                            else
                            {
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Different user asked question - no toast shown ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}] 🚫 TOAST NOT SHOWN (QuestionAnswered) ;CLEANUP_OK", requestId);
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - CurrentUserGuid: '{CurrentUser}' ;CLEANUP_OK", requestId, CurrentUserGuid ?? "NULL");
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - OriginalAskerGuid: '{AskerGuid}' ;CLEANUP_OK", requestId, originalAskerGuid ?? "NULL");
                                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:toast:TRACE] [{RequestId}]   - GUIDs Match: FALSE ;CLEANUP_OK", requestId);
                            }
                            
                            await InvokeAsync(StateHasChanged);
                            Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ✅ Question {QuestionId} removed from participant view ;CLEANUP_OK", requestId, questionId);
                        }
                        else
                        {
                            Logger.LogWarning("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] Question not found in local list ;CLEANUP_OK", requestId);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] 💥 Error processing QuestionAnswered: {Message} ;CLEANUP_OK", requestId, ex.Message);
                }
                
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] SessionCanvas QuestionAnswered handler COMPLETE ;CLEANUP_OK", requestId);
                Logger.LogInformation("[DEBUG-WORKITEM:hcp-questions:answered] [{RequestId}] ════════════════════════════════════════════════════════════════ ;CLEANUP_OK", requestId);
            });

            hubConnection.On<ParticipantApiData>("ParticipantJoined", async (apiParticipant) =>
            {
                if (Model?.Participants != null)
                {
                    var participant = new ParticipantData
                    {
                        UserId = apiParticipant.UserId,
                        Name = apiParticipant.DisplayName,
                        Country = apiParticipant.Country ?? "",
                        Flag = apiParticipant.CountryFlag ?? ""
                    };
                    Model.Participants.Add(participant);
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<string>("ParticipantLeft", async (userId) =>
            {
                if (Model?.Participants != null)
                {
                    var participant = Model.Participants.FirstOrDefault(p => p.UserId == userId);
                    if (participant != null)
                    {
                        Model.Participants.Remove(participant);
                        await InvokeAsync(StateHasChanged);
                    }
                }
            });

            // HTML content broadcasting events (using working SimpleSignalRTest pattern)
            hubConnection.On<object>("HtmlContentReceived", async (broadcastData) =>
            {
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas:broadcast] HtmlContentReceived event received");
                    
                    var json = System.Text.Json.JsonSerializer.Serialize(broadcastData);
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    
                    if (root.TryGetProperty("htmlContent", out var htmlElement))
                    {
                        var htmlContent = htmlElement.GetString();
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:broadcast] Received HTML content: {Length} chars", htmlContent?.Length ?? 0);
                        
                        if (Model != null)
                        {
                            Model.SharedAssetContent = htmlContent;
                            await InvokeAsync(StateHasChanged);
                        }
                        
                        Logger.LogInformation("[DEBUG-WORKITEM:canvas:broadcast] HTML content displayed in session canvas");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:broadcast] Error processing HtmlContentReceived event");
                }
            });

            // [DEBUG-WORKITEM:hcp] Listen for canvas clear events to show default message ;CLEANUP_OK
            hubConnection.On("ClearCanvas", async () =>
            {
                Logger.LogInformation("SIGNALR-DIAG: [SC-ClearCanvas] Event fired - DiagId={DiagId}", diagId);
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:hcp] ClearCanvas event received, clearing SharedAssetContent ;CLEANUP_OK");
                    
                    if (Model != null)
                    {
                        Model.SharedAssetContent = null;
                        await InvokeAsync(StateHasChanged);
                        Logger.LogInformation("[DEBUG-WORKITEM:hcp] ✅ Canvas cleared - default message will be displayed ;CLEANUP_OK");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:hcp] ❌ Error processing ClearCanvas event: {Message} ;CLEANUP_OK", ex.Message);
                }
            });

            // [DEBUG-WORKITEM:canvas-questions:session-status] Listen for session began events to enable Q&A ;CLEANUP_OK
            hubConnection.On<object>("SessionBegan", async (sessionData) =>
            {
                Logger.LogInformation("SIGNALR-DIAG: [SC-SessionBegan] Event fired - DiagId={DiagId}", diagId);
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:session-status] SessionBegan event received, enabling Q&A input ;CLEANUP_OK");
                    
                    var json = System.Text.Json.JsonSerializer.Serialize(sessionData);
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    
                    // Update session status to Active
                    await InvokeAsync(() =>
                    {
                        if (Model != null)
                        {
                            Model.SessionStatus = "Active";
                            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:session-status] Model.SessionStatus updated to Active, Q&A input now enabled ;CLEANUP_OK");
                            StateHasChanged();
                        }
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:canvas-questions:session-status] Error processing SessionBegan event ;CLEANUP_OK");
                }
            });

            // [DEBUG-WORKITEM:session-ended:hub] Listen for session ended events ;CLEANUP_OK
            hubConnection.On<object>("SessionEnded", async (endData) =>
            {
                Logger.LogInformation("SIGNALR-DIAG: [SC-SessionEnded] Event fired - DiagId={DiagId}", diagId);
                try
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:session-ended:redirect] SessionEnded event received ;CLEANUP_OK");
                    
                    var json = System.Text.Json.JsonSerializer.Serialize(endData);
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    
                    int sessionId = 0;
                    if (root.TryGetProperty("sessionId", out var sessionIdElement))
                    {
                        sessionId = sessionIdElement.GetInt32();
                    }
                    
                    Logger.LogInformation("[DEBUG-WORKITEM:session-ended:redirect] Session {SessionId} has ended, redirecting to SessionEnded page ;CLEANUP_OK", sessionId);
                    
                    // [DEBUG-WORKITEM:prod-issues:url-fix] No hardcoded URLs - using relative navigation
                    await InvokeAsync(() =>
                    {
                        Navigation.NavigateTo($"/session/ended/{sessionId}", forceLoad: true);
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "[DEBUG-WORKITEM:session-ended:redirect] Error processing SessionEnded event ;CLEANUP_OK");
                }
            });

            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🚀 Starting SignalR connection...");
            Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] Starting connection - DiagId={DiagId}", diagId);
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] Starting SignalR connection...");
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ REGISTERING SIGNALR HANDLERS ════════ ;CLEANUP_OK");
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] Handlers registered: QuestionReceived, QuestionUpdated, QuestionVoteUpdated, QuestionVoteUpdate, QuestionDeleted, ParticipantJoined, ParticipantLeft, SessionEnded ;CLEANUP_OK");
            
            await hubConnection.StartAsync();
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ✅ SIGNALR CONNECTED - State={State}, ConnectionId={ConnectionId} ;CLEANUP_OK", 
                hubConnection.State, hubConnection.ConnectionId ?? "NULL");
            Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] Connection established - ConnectionId={ConnectionId}, State={State}, DiagId={DiagId}",
                hubConnection.ConnectionId, hubConnection.State, diagId);
            
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] ✅ SignalR connected: State={State}, ConnectionId={ConnectionId}", hubConnection.State, hubConnection.ConnectionId);
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] SignalR connection started successfully, State: {State}", hubConnection.State);
            
            if (Model?.SessionId > 0)
            {
                var connectionTrackingId = Guid.NewGuid().ToString("N")[..8];
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ════════ JOINING SIGNALR GROUP ════════ SessionId={SessionId}, GroupName=Session_{SessionId}, Role=participant ;CLEANUP_OK",
                    Model.SessionId, Model.SessionId);
                Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] Joining session group - SessionId={SessionId}, DiagId={DiagId}",
                    Model.SessionId, diagId);
                
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🔄 Attempting to join session group: session_{SessionId}", Model.SessionId);
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CONNECTION-TRACK] 🔗 GROUP JOIN: Attempting to join session_{SessionId}, connectionTrackingId={ConnectionTrackingId} ;CLEANUP_OK", Model.SessionId, connectionTrackingId);
                
                await hubConnection.SendAsync("JoinSession", Model.SessionId, "participant");
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:upvote] ✅ JoinSession CALL COMPLETE - Waiting for server confirmation ;CLEANUP_OK");
                Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] Joined session group - session_{SessionId}, DiagId={DiagId}",
                    Model.SessionId, diagId);
                
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] ✅ Joined SignalR group: session_{SessionId}", Model.SessionId);
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CONNECTION-TRACK] ✅ GROUP SUCCESS: Joined session_{SessionId} as participant, connectionTrackingId={ConnectionTrackingId} ;CLEANUP_OK", Model.SessionId, connectionTrackingId);
                
                // Test message to verify group membership
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 🧪 Testing group membership for session_{SessionId}", Model.SessionId);
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CONNECTION-TRACK] 📡 GROUP READY: SessionCanvas ready to receive broadcasts in session_{SessionId}, connectionTrackingId={ConnectionTrackingId} ;CLEANUP_OK", Model.SessionId, connectionTrackingId);
            }
            else
            {
                Logger.LogWarning("[DEBUG-WORKITEM:hostcanvas:CANVAS] ⚠️ SessionId not available - cannot join SignalR group");
                Logger.LogWarning("SIGNALR-DIAG: [SC-InitializeSignalRAsync] SKIP group join - SessionId not available, DiagId={DiagId}", diagId);
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] 📊 Model state: SessionId={SessionId}, SessionName={SessionName}", Model?.SessionId, Model?.SessionName);
            }
            
            // Trigger UI update to show connected status
            lastConnectionTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
            Logger.LogInformation("SIGNALR-DIAG: [SC-InitializeSignalRAsync] COMPLETE - All setup finished, DiagId={DiagId}", diagId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:hostcanvas:CANVAS] Error initializing SignalR connection: {Error}", ex.Message);
            Logger.LogError("SIGNALR-DIAG: [SC-InitializeSignalRAsync] ERROR - Message={Message}, DiagId={DiagId}",
                ex.Message, diagId);
            // Trigger UI update to show disconnected status with retry button
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPersistedSessionStateAsync(string requestId)
    {
        try
        {
            Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] Loading persisted session state from localStorage", requestId);
            
            var sessionState = await SessionStateService.LoadSessionStateAsync();
            
            if (sessionState != null)
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] Found persisted SessionId: {SessionId}", 
                    requestId, sessionState.SessionId);
                
                // Only use persisted state if we don't have a current SessionId
                if (_sessionId == null || _sessionId == 0)
                {
                    _sessionId = sessionState.SessionId;
                    
                    // Pre-populate model with persisted data to avoid empty initial state
                    if (Model != null)
                    {
                        Model.SessionId = sessionState.SessionId;
                        Model.SessionName = sessionState.SessionName;
                        Model.Topic = sessionState.Topic;
                        Model.ParticipantCount = sessionState.ParticipantCount;
                        
                        // Update the formatted display fields
                        if (sessionState.StartedAt.HasValue)
                        {
                            Model.SessionDate = FormatDate(sessionState.StartedAt.Value);
                            Model.StartTime = FormatTime(sessionState.StartedAt.Value);
                            Model.SessionStartTime = sessionState.StartedAt.Value;
                        }
                        
                        Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] Pre-populated model with persisted data", requestId);
                        await InvokeAsync(StateHasChanged);
                    }
                }
                else
                {
                    Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] Current SessionId ({CurrentSessionId}) exists, skipping persisted SessionId ({PersistedSessionId})", 
                        requestId, _sessionId, sessionState.SessionId);
                }
            }
            else
            {
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] No persisted session state found", requestId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:hostcanvas:SESSION] [{RequestId}] Error loading persisted session state", requestId);
        }
    }

    private async Task SaveSessionStateAsync()
    {
        try
        {
            if (_sessionId.HasValue && Model != null)
            {
                var sessionState = new NoorCanvas.Services.SessionStateService.SessionState
                {
                    SessionId = (int)_sessionId.Value,
                    SessionName = Model.SessionName ?? "Unknown Session",
                    SessionDescription = "Session Canvas View",
                    SessionStatus = "Active",
                    Topic = Model.Topic ?? "Session Content",
                    ParticipantCount = Model.ParticipantCount,
                    StartedAt = Model.SessionStartTime,
                    CreatedAt = DateTime.UtcNow
                };

                var saved = await SessionStateService.SaveSessionStateAsync(sessionState);
                
                Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:SESSION] Session state saved: {Success} for SessionId: {SessionId}", 
                    saved, _sessionId.Value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:hostcanvas:SESSION] Error saving session state");
        }
    }

