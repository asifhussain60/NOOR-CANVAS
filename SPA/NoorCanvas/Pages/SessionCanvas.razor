    // [DEBUG-WORKITEM:canvas:sidebar-height:trace] Legacy dimension logging (fallback) ;CLEANUP_OK
    private async Task LogSidebarDimensionsLegacy()
    {
        var requestId = Guid.NewGuid().ToString("N").Substring(0, 8);
        
        try
        {
            // [DEBUG-WORKITEM:canvas:sidebar-height:trace] Enhanced dimension logging with computed styles ;CLEANUP_OK
            // Get canvas-area-container dimensions and computed styles
            var canvasAreaInfo = await JSRuntime.InvokeAsync<ContainerInfo>("eval", @"
                (function() {
                    var container = document.querySelector('.canvas-area-container');
                    if (!container) return { width: 0, height: 0, scrollHeight: 0, found: false };
                    var rect = container.getBoundingClientRect();
                    var computedStyle = window.getComputedStyle(container);
                    return {
                        width: rect.width,
                        height: rect.height,
                        scrollHeight: container.scrollHeight,
                        computedHeight: computedStyle.height,
                        computedMinHeight: computedStyle.minHeight,
                        computedMaxHeight: computedStyle.maxHeight,
                        found: true
                    };
                })()
            ");
            
            // Get canvas-sidebar dimensions and computed styles
            var sidebarInfo = await JSRuntime.InvokeAsync<ContainerInfo>("eval", @"
                (function() {
                    var sidebar = document.querySelector('.canvas-sidebar');
                    if (!sidebar) return { width: 0, height: 0, scrollHeight: 0, found: false };
                    var rect = sidebar.getBoundingClientRect();
                    var computedStyle = window.getComputedStyle(sidebar);
                    return {
                        width: rect.width,
                        height: rect.height,
                        scrollHeight: sidebar.scrollHeight,
                        computedHeight: computedStyle.height,
                        computedMinHeight: computedStyle.minHeight,
                        computedMaxHeight: computedStyle.maxHeight,
                        found: true
                    };
                })()
            ");
            
            // Get canvas-questions-container dimensions
            var questionsContainerDimensions = await JSRuntime.InvokeAsync<DimensionResult>("eval", @"
                (function() {
                    var container = document.querySelector('.canvas-questions-container');
                    if (!container) return { width: 0, height: 0, scrollHeight: 0, found: false };
                    var rect = container.getBoundingClientRect();
                    return {
                        width: rect.width,
                        height: rect.height,
                        scrollHeight: container.scrollHeight,
                        found: true
                    };
                })()
            ");
            
            // Get canvas-main-grid dimensions
            var gridInfo = await JSRuntime.InvokeAsync<ContainerInfo>("eval", @"
                (function() {
                    var grid = document.querySelector('.canvas-main-grid');
                    if (!grid) return { width: 0, height: 0, scrollHeight: 0, found: false };
                    var rect = grid.getBoundingClientRect();
                    var computedStyle = window.getComputedStyle(grid);
                    return {
                        width: rect.width,
                        height: rect.height,
                        scrollHeight: grid.scrollHeight,
                        computedHeight: computedStyle.height,
                        computedMinHeight: computedStyle.minHeight,
                        computedMaxHeight: computedStyle.maxHeight,
                        found: true
                    };
                })()
            ");
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📐 CANVAS-MAIN-GRID - Width: {Width}px, Height: {Height}px, ScrollHeight: {ScrollHeight}px, Computed: {Computed}, Min: {Min}, Max: {Max} ;CLEANUP_OK", 
                requestId, gridInfo.Width, gridInfo.Height, gridInfo.ScrollHeight, gridInfo.ComputedHeight, gridInfo.ComputedMinHeight, gridInfo.ComputedMaxHeight);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📐 CANVAS-AREA-CONTAINER - Width: {Width}px, Height: {Height}px, ScrollHeight: {ScrollHeight}px, Computed: {Computed}, Min: {Min}, Max: {Max} ;CLEANUP_OK", 
                requestId, canvasAreaInfo.Width, canvasAreaInfo.Height, canvasAreaInfo.ScrollHeight, canvasAreaInfo.ComputedHeight, canvasAreaInfo.ComputedMinHeight, canvasAreaInfo.ComputedMaxHeight);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📐 CANVAS-SIDEBAR - Width: {Width}px, Height: {Height}px, ScrollHeight: {ScrollHeight}px, Computed: {Computed}, Min: {Min}, Max: {Max} ;CLEANUP_OK", 
                requestId, sidebarInfo.Width, sidebarInfo.Height, sidebarInfo.ScrollHeight, sidebarInfo.ComputedHeight, sidebarInfo.ComputedMinHeight, sidebarInfo.ComputedMaxHeight);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📐 CANVAS-QUESTIONS-CONTAINER - Width: {Width}px, Height: {Height}px, ScrollHeight: {ScrollHeight}px, Found: {Found} ;CLEANUP_OK", 
                requestId, questionsContainerDimensions.Width, questionsContainerDimensions.Height, questionsContainerDimensions.ScrollHeight, questionsContainerDimensions.Found);
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📊 Total Questions in Model: {Count} ;CLEANUP_OK", 
                requestId, Model?.Questions?.Count ?? 0);
            
            // [DEBUG-WORKITEM:canvas:sidebar-height:trace] Compare canvas-area vs sidebar heights to detect expansion ;CLEANUP_OK
            if (canvasAreaInfo.Found && sidebarInfo.Found)
            {
                var heightDiff = canvasAreaInfo.Height - sidebarInfo.Height;
                Logger.LogInformation("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 📊 HEIGHT COMPARISON - Canvas Area vs Sidebar Diff: {HeightDiff}px (Canvas: {CanvasH}px, Sidebar: {SidebarH}px) ;CLEANUP_OK", 
                    requestId, heightDiff, canvasAreaInfo.Height, sidebarInfo.Height);
                
                if (Math.Abs(heightDiff) > 50)
                {
                    Logger.LogWarning("[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] ⚠️ SIGNIFICANT HEIGHT DIFFERENCE DETECTED - Canvas and sidebar should be equal in grid layout ;CLEANUP_OK", requestId);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:canvas:sidebar-height:trace] [{RequestId}] 💥 Failed to log dimensions: {Message} ;CLEANUP_OK", requestId, ex.Message);
        }
    }
    
    // Helper class for dimension logging with computed styles
    private class ContainerInfo
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double ScrollHeight { get; set; }
        public string ComputedHeight { get; set; } = "";
        public string ComputedMinHeight { get; set; } = "";
        public string ComputedMaxHeight { get; set; } = "";
        public bool Found { get; set; }
    }
    
    // Helper class for dimension logging
    private class DimensionResult
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double ScrollHeight { get; set; }
        public bool Found { get; set; }
    }

    // Enter Key Handler
    private async Task HandleQuestionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:keyboard] Enter key pressed - SessionStatus: {Status}, Enabled: {Enabled} ;CLEANUP_OK", 
                Model?.SessionStatus ?? "null", Model?.SessionStatus == "Active");
            
            // Prevent submission if session not active
            if (Model?.SessionStatus != "Active")
            {
                Logger.LogWarning("[DEBUG-WORKITEM:canvas-questions:keyboard] Question submission blocked - session not active ;CLEANUP_OK");
                return;
            }
            
            Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:keyboard] Enter key submit triggered ;CLEANUP_OK");
            
            // Prevent default newline behavior
            await SubmitQuestion();
        }
    }
}