    // [DEBUG-WORKITEM:userlanding:session-ended] Check session status before allowing access ;CLEANUP_OK
    /// <summary>
    /// Check if session has ended before allowing access
    /// Prevents users from accessing ended sessions
    /// </summary>
    private async Task<(bool IsEnded, long SessionId)> CheckSessionStatusAsync(string token, string requestId)
    {
        try
        {
            Logger.LogInformation("[DEBUG-WORKITEM:userlanding:session-ended] Checking session status for token: {0} ;CLEANUP_OK", token);

            using var httpClient = HttpClientFactory.CreateClient("default");
            var validationUrl = $"/api/participant/session/{token}/validate";
            var response = await httpClient.GetAsync(validationUrl);

            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("[DEBUG-WORKITEM:userlanding:session-ended] Session validation API failed: {0} ;CLEANUP_OK", 
                    response.StatusCode);
                return (false, 0);
            }

            var validationContent = await response.Content.ReadAsStringAsync();
            var validationData = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(validationContent,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (validationData.TryGetProperty("Session", out var sessionElement))
            {
                var sessionId = sessionElement.GetProperty("SessionId").GetInt64();
                var status = sessionElement.GetProperty("Status").GetString() ?? "";
                
                var isEnded = string.Equals(status, "Ended", StringComparison.OrdinalIgnoreCase);
                
                Logger.LogInformation("[DEBUG-WORKITEM:userlanding:session-ended] Session {SessionId} status: {Status}, IsEnded: {IsEnded} ;CLEANUP_OK", 
                    sessionId, status, isEnded);
                
                return (isEnded, sessionId);
            }

            Logger.LogWarning("[DEBUG-WORKITEM:userlanding:session-ended] No session data in validation response ;CLEANUP_OK");
            return (false, 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:userlanding:session-ended] Exception during session status check ;CLEANUP_OK");
            return (false, 0);
        }
    }

    // [DEBUG-WORKITEM:userlanding:guard:canvas] AUTHENTICATION GATE: Verify participant registration before allowing session access ;CLEANUP_OK
    /// <summary>
    /// AUTHENTICATION GATE: Verify if user is registered as participant before allowing session access
    /// Fixes bug where unregistered users could bypass registration requirement
    /// </summary>
    private async Task<bool> CheckParticipantRegistrationAsync(string token, string requestId)
    {
        try
        {
            Logger.LogInformation("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] Checking participant registration status for token: {Token} ;CLEANUP_OK", 
                requestId, token);

            // [SECURITY] Get stored UserGuid from browser storage (per-participant isolation)
            var storedUserGuid = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", $"noor_user_guid_{token}");
            
            if (string.IsNullOrEmpty(storedUserGuid))
            {
                // Fallback to localStorage for cross-tab persistence
                storedUserGuid = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"noor_user_guid_{token}");
            }

            if (string.IsNullOrEmpty(storedUserGuid))
            {
                Logger.LogWarning("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] No UserGuid found in storage - user must register ;CLEANUP_OK", 
                    requestId);
                return false;
            }

            Logger.LogInformation("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] Found stored UserGuid: {UserGuid}, verifying against database ;CLEANUP_OK", 
                requestId, storedUserGuid);

            // [SECURITY] Verify this UserGuid exists in canvas.Participants for this session
            using var httpClient = HttpClientFactory.CreateClient("default");
            var participantsUrl = $"/api/participant/session/{token}/participants"; 
            var response = await httpClient.GetAsync(participantsUrl);

            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] Participant check API failed: {StatusCode} ;CLEANUP_OK", 
                    requestId, response.StatusCode);
                return false;
            }

            var participantsContent = await response.Content.ReadAsStringAsync();
            var participantsData = System.Text.Json.JsonSerializer.Deserialize<ParticipantsCheckResponse>(participantsContent,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (participantsData?.Participants == null)
            {
                Logger.LogWarning("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] No participants data returned from API ;CLEANUP_OK", 
                    requestId);
                return false;
            }

            // [SECURITY] Check if stored UserGuid matches ANY participant in database
            var isRegistered = participantsData.Participants.Any(p => 
                string.Equals(p.UserId, storedUserGuid, StringComparison.OrdinalIgnoreCase));
            
            if (isRegistered)
            {
                Logger.LogInformation("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] ✓ Registration verified: UserGuid {UserGuid} found in database ;CLEANUP_OK", 
                    requestId, storedUserGuid);
            }
            else
            {
                Logger.LogWarning("[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] ✗ SECURITY VIOLATION: UserGuid {UserGuid} in storage but NOT in database - possible tampering ;CLEANUP_OK", 
                    requestId, storedUserGuid);
                
                // Clear invalid UserGuid from storage
                await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", $"noor_user_guid_{token}");
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"noor_user_guid_{token}");
            }
            
            return isRegistered;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DEBUG-WORKITEM:userlanding:guard:canvas] [{RequestId}] Exception during registration check ;CLEANUP_OK", 
                requestId);
            return false;
        }
    }

