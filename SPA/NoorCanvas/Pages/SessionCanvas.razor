<DebugPanel CurrentViewName="SessionCanvas" 
            DebugActions="GetSessionCanvasDebugActions()" 
            GenericMessage="Session Canvas debug actions" />

@implements IAsyncDisposable

@code {
    [Parameter] public string? SessionToken { get; set; }
    
    private SessionCanvasViewModel? Model { get; set; }
    private int? _sessionId;
    private HubConnection? hubConnection;
    private HttpClient? Http;
    private string CurrentUserGuid { get; set; } = string.Empty;

    // [DIAGNOSTIC-COMPONENT] Reusable diagnostic logger ;CLEANUP_OK
    private DiagnosticLogger? diagnosticLogger;

    // UI State
    private string QuestionInput { get; set; } = string.Empty;
    private int? EditingQuestionIndex { get; set; }
    private int? QuestionToDeleteIndex { get; set; }
    private bool IsModalVisible { get; set; } = false;
    private HashSet<string> VotedQuestionIds { get; set; } = new HashSet<string>();

    private enum Tab { QA, Participants }
    private Tab ActiveTab { get; set; } = Tab.QA;

    // [REFACTOR:Phase3] SignalR Event Callbacks - Extracted from inline handlers
    private async Task OnQuestionAdded(QuestionData question)
    {
        if (Model?.Questions != null && !Model.Questions.Any(q => q.QuestionId == question.QuestionId))
        {
            Model.Questions.Add(question);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnQuestionUpdated(QuestionData updatedQuestion)
    {
        if (Model?.Questions != null && updatedQuestion.QuestionId != null)
        {
            var existingQuestion = Model.Questions.FirstOrDefault(q => q.QuestionId == updatedQuestion.QuestionId);
            if (existingQuestion != null && updatedQuestion.Text != null)
            {
                existingQuestion.Text = updatedQuestion.Text;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnQuestionDeleted(string questionId, string? originalAskerGuid)
    {
        if (Model?.Questions != null && questionId != null)
        {
            var questionToRemove = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
            if (questionToRemove != null)
            {
                Model.Questions.Remove(questionToRemove);
                
                if (!string.IsNullOrEmpty(CurrentUserGuid) && !string.IsNullOrEmpty(originalAskerGuid) && CurrentUserGuid == originalAskerGuid)
                {
                    await JSRuntime.InvokeVoidAsync("showNoorToast", 
                        "The host has removed your question. It may be addressed differently or outside this Q&A session.", 
                        "Question Removed", 
                        "info");
                }
                
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnVoteUpdated(string questionId, int newVoteCount)
    {
        if (Model?.Questions != null && questionId != null)
        {
            var existingQuestion = Model.Questions.FirstOrDefault(q => q.QuestionId == questionId);
            if (existingQuestion != null)
            {
                existingQuestion.Votes = newVoteCount;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

