        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - Questions Count: {Count} ;CLEANUP_OK", requestId, Model?.Questions?.Count ?? 0);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:update] [{RequestId}]   - QuestionInput: '{Input}' ;CLEANUP_OK", requestId, QuestionInput ?? "NULL");
