        Logger.LogInformation("[DEBUG-WORKITEM:canvas:layout] [{RequestId}] Canvas div height set to fixed 600px for shareable assets ;CLEANUP_OK", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:canvas:layout] [{RequestId}] Responsive layout configured - sidebar moves below on mobile ;CLEANUP_OK", requestId);
        Logger.LogInformation("[DEBUG-WORKITEM:hostcanvas:CANVAS] [{RequestId}] Loading session data first, then initializing SignalR", requestId);
        
        // API-BASED APPROACH: UserGuid will be retrieved from API during participant loading
        // This eliminates storage dependency and ensures proper multi-browser isolation
        
        // Check for persisted session state first (for page refresh/navigation scenarios)
        await LoadPersistedSessionStateAsync(requestId);
        
        // Initialize session data FIRST so SessionId is available
        await InitializeSessionAsync(requestId);
        
        // Then initialize SignalR connection with SessionId available
        await InitializeSignalRAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var requestId = Guid.NewGuid().ToString("N")[..8];
            try
            {
                // [DEBUG-WORKITEM:canvas-questions:toastr:trace] Verify toastr library loaded after first render ;CLEANUP_OK
                var toastrAvailable = await JSRuntime.InvokeAsync<bool>("eval", "typeof toastr !== 'undefined'");
                var showNoorToastAvailable = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.showNoorToast === 'function'");
                
                Logger.LogInformation("[DEBUG-WORKITEM:canvas-questions:toastr:trace] [{RequestId}] OnAfterRenderAsync - toastr available: {ToastrAvailable}, showNoorToast available: {ShowNoorToastAvailable} ;CLEANUP_OK", 
                    requestId, toastrAvailable, showNoorToastAvailable);
                
                if (!toastrAvailable)
                {
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:toastr:trace] [{RequestId}] ❌ CRITICAL: toastr library NOT loaded - CDN may be blocked or script failed ;CLEANUP_OK", requestId);
                }
                
                if (!showNoorToastAvailable)
                {
                    Logger.LogError("[DEBUG-WORKITEM:canvas-questions:toastr:trace] [{RequestId}] ❌ CRITICAL: showNoorToast function NOT defined - _Host.cshtml script may not be executing ;CLEANUP_OK", requestId);
