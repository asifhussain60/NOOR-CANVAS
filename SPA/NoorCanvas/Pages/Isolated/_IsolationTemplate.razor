@code {
    // Parameters
    private List<TestParameter> testParameters = new();
    private List<TestScenario> testScenarios = new();
    private List<TestResult> testResults = new();
    private List<DebugLog> debugLogs = new();
    private string debugLevel = "trace";
    private string testStatus = "Ready";
    private bool isExecuting = false;
    private RenderFragment? functionalityPreview = null;
    private string runId = GenerateRunId();

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("[DEBUG-WORKITEM:isolate-template:lifecycle:{RunId}] Isolation view initializing ;CLEANUP_OK", runId);
        
        await InitializeTestParameters();
        await LoadTestScenarios();
        
        Logger.LogInformation("[DEBUG-WORKITEM:isolate-template:lifecycle:{RunId}] Isolation view initialized ;CLEANUP_OK", runId);
    }

    private Task InitializeTestParameters()
    {
        Logger.LogTrace("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Initializing test parameters ;CLEANUP_OK", runId);
        
        // TODO: Define your test parameters here
        testParameters.Add(new TestParameter
        {
            Name = "Example Parameter",
            Type = typeof(string),
            Required = true,
            Placeholder = "Enter value",
            Description = "Description of what this parameter does",
            Value = null
        });
        
        LogToViewer("INFO", "ui", $"Initialized {testParameters.Count} test parameters");
        return Task.CompletedTask;
    }

    private Task LoadTestScenarios()
    {
        Logger.LogTrace("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Loading test scenarios ;CLEANUP_OK", runId);
        
        // TODO: Define your test scenarios here
        testScenarios.Add(new TestScenario
        {
            Name = "Happy Path",
            Description = "Test successful execution with valid inputs",
            Parameters = new Dictionary<string, object>
            {
                ["Example Parameter"] = "Valid Value"
            }
        });
        
        LogToViewer("INFO", "ui", $"Loaded {testScenarios.Count} test scenarios");
        return Task.CompletedTask;
    }

    private async Task ExecuteTest()
    {
        isExecuting = true;
        testStatus = "Executing";
        StateHasChanged();
        
        var testId = Guid.NewGuid().ToString("N").Substring(0, 8);
        Logger.LogInformation("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Starting test - TestId={TestId} ;CLEANUP_OK", runId, testId);
        LogToViewer("INFO", "ui", $"Test execution started - TestId={testId}");

        try
        {
            if (!ValidateParameters())
            {
                AddResult("ERROR", "Parameter validation failed", "Check required parameters");
                LogToViewer("ERROR", "ui", "Parameter validation failed");
                return;
            }

            LogToViewer("SUCCESS", "ui", "Parameters validated");

            await ExecuteIsolatedFunctionality();

            testStatus = "Success";
            AddResult("SUCCESS", "Test completed successfully", null);
            LogToViewer("SUCCESS", "ui", "Test execution completed");
        }
        catch (Exception ex)
        {
            testStatus = "Failed";
            Logger.LogError(ex, "[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Test failed - TestId={TestId} ;CLEANUP_OK", runId, testId);
            AddResult("ERROR", $"Test failed: {ex.Message}", ex.StackTrace);
            LogToViewer("ERROR", "ui", $"Test failed: {ex.Message}");
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteIsolatedFunctionality()
    {
        Logger.LogTrace("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Executing isolated functionality ;CLEANUP_OK", runId);
        LogToViewer("INFO", "ui", "Calling isolated functionality...");

        // TODO: Implement your isolated functionality here
        // This is where you copy the exact logic from the source files
        
        await Task.Delay(100); // Placeholder - remove this
        
        AddResult("INFO", "Placeholder execution", "Replace with actual functionality");
    }

    private bool ValidateParameters()
    {
        foreach (var param in testParameters.Where(p => p.Required))
        {
            if (param.Value == null)
            {
                Logger.LogWarning("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Required parameter missing: {ParamName} ;CLEANUP_OK", runId, param.Name);
                return false;
            }
        }
        return true;
    }

    private T? GetParameterValue<T>(string paramName)
    {
        var param = testParameters.FirstOrDefault(p => p.Name == paramName);
        return param != null ? (T?)param.Value : default(T);
    }

    private void AddResult(string status, string message, string? details)
    {
        testResults.Add(new TestResult
        {
            Timestamp = DateTime.Now,
            Status = status,
            StatusClass = status.ToLower(),
            Message = message,
            Details = details
        });
        StateHasChanged();
    }

    private void LogToViewer(string level, string layer, string message)
    {
        debugLogs.Add(new DebugLog
        {
            Timestamp = DateTime.Now,
            Level = level,
            Layer = layer,
            LevelClass = $"log-{level.ToLower()}",
            Message = message
        });
        StateHasChanged();
    }

    private void ClearResults()
    {
        testResults.Clear();
        testStatus = "Ready";
        StateHasChanged();
    }

    private void ClearLogs()
    {
        debugLogs.Clear();
        StateHasChanged();
    }

    private void ResetParameters()
    {
        foreach (var param in testParameters)
        {
            param.Value = null;
        }
        StateHasChanged();
    }

    private void LoadScenario(TestScenario scenario)
    {
        Logger.LogInformation("[DEBUG-WORKITEM:isolate-template:ui:{RunId}] Loading scenario: {ScenarioName} ;CLEANUP_OK", runId, scenario.Name);
        
        foreach (var param in testParameters)
        {
            if (scenario.Parameters.ContainsKey(param.Name))
            {
                param.Value = scenario.Parameters[param.Name];
            }
        }
        
        LogToViewer("INFO", "ui", $"Loaded scenario: {scenario.Name}");
        StateHasChanged();
    }

    private static string GenerateRunId()
    {
        return $"{DateTime.Now:HHmmss}-{Guid.NewGuid().ToString("N").Substring(0, 4)}";
    }

    // Supporting classes
    private class TestParameter
    {
        public string Name { get; set; } = "";
        public Type Type { get; set; } = typeof(string);
        public bool Required { get; set; }
        public string Placeholder { get; set; } = "";
        public string Description { get; set; } = "";
        public object? Value { get; set; }
    }

    private class TestScenario
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public Dictionary<string, object> Parameters { get; set; } = new();
    }

    private class TestResult
    {
        public DateTime Timestamp { get; set; }
        public string Status { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string Message { get; set; } = "";
        public string? Details { get; set; }
    }

    private class DebugLog
    {
        public DateTime Timestamp { get; set; }
        public string Level { get; set; } = "";
        public string Layer { get; set; } = "";
        public string LevelClass { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
