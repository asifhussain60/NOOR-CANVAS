@*
    ISOLATION VIEW TEMPLATE
    
    This is a template for creating isolated functionality testing views.
    Copy this file and customize for your specific feature.
    
    DO NOT use this template directly - it's for reference only.
    
    Usage:
    1. Copy this file to {FeatureName}Isolation.razor
    2. Update @page route
    3. Add required @inject services
    4. Define test parameters
    5. Implement ExecuteIsolatedFunctionality()
    6. Extract and include original styling
*@

@page "/isolated/template"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<_IsolationTemplate> Logger
@* Add your required service injections here *@

<PageTitle>Isolation Test: Template</PageTitle>

<div class="isolation-container">
    <!-- Header Section -->
    <div class="isolation-header">
        <h1 class="isolation-title">
            <i class="fas fa-flask"></i>
            Isolation Test: {Feature Name}
        </h1>
        <div class="isolation-subtitle">
            Testing in isolation for debugging and validation
        </div>
        <div class="isolation-meta">
            <span class="badge">Key: isolate-{feature}</span>
            <span class="badge">Debug: @debugLevel</span>
            <span class="badge">Status: @testStatus</span>
        </div>
    </div>

    <!-- Parameter Controls Section -->
    <div class="isolation-controls">
        <h2 class="section-title">
            <i class="fas fa-sliders-h"></i>
            Test Parameters
        </h2>
        
        @foreach (var param in testParameters)
        {
            <div class="control-group">
                <label class="control-label">
                    @param.Name
                    @if (param.Required)
                    {
                        <span class="required">*</span>
                    }
                </label>
                
                @if (param.Type == typeof(string))
                {
                    <input type="text" 
                           class="control-input"
                           @bind="param.Value"
                           placeholder="@param.Placeholder" />
                }
                else if (param.Type == typeof(int))
                {
                    <input type="number" 
                           class="control-input"
                           @bind="param.Value"
                           placeholder="@param.Placeholder" />
                }
                else if (param.Type == typeof(bool))
                {
                    <input type="checkbox" 
                           class="control-checkbox"
                           checked="@(param.Value is bool b && b)"
                           @onchange="@((ChangeEventArgs e) => param.Value = e.Value)" />
                }
                else if (param.Type == typeof(DateTime))
                {
                    <input type="datetime-local" 
                           class="control-input"
                           value="@(param.Value is DateTime dt ? dt.ToString("yyyy-MM-ddTHH:mm") : "")"
                           @onchange="@((ChangeEventArgs e) => param.Value = DateTime.TryParse(e.Value?.ToString(), out var result) ? result : null)" />
                }
                
                <span class="control-hint">@param.Description</span>
            </div>
        }
    </div>

    <!-- Action Buttons Section -->
    <div class="isolation-actions">
        <button class="btn btn-primary" 
                @onclick="ExecuteTest" 
                disabled="@isExecuting">
            @if (isExecuting)
            {
                <i class="fas fa-spinner fa-spin"></i>
                <span>Executing...</span>
            }
            else
            {
                <i class="fas fa-play"></i>
                <span>Execute Test</span>
            }
        </button>
        
        <button class="btn btn-secondary" 
                @onclick="ClearResults">
            <i class="fas fa-eraser"></i>
            <span>Clear Results</span>
        </button>
        
        <button class="btn btn-secondary" 
                @onclick="ResetParameters">
            <i class="fas fa-undo"></i>
            <span>Reset Parameters</span>
        </button>
    </div>

    <!-- Test Scenarios Section -->
    @if (testScenarios.Any())
    {
        <div class="isolation-scenarios">
            <h2 class="section-title">
                <i class="fas fa-list-check"></i>
                Test Scenarios
            </h2>
            
            <div class="scenario-grid">
                @foreach (var scenario in testScenarios)
                {
                    <button class="scenario-button" 
                            @onclick="() => LoadScenario(scenario)">
                        <i class="fas fa-vial"></i>
                        <span>@scenario.Name</span>
                    </button>
                }
            </div>
        </div>
    }

    <!-- Results Display Section -->
    <div class="isolation-results">
        <h2 class="section-title">
            <i class="fas fa-chart-bar"></i>
            Test Results
        </h2>
        
        @if (testResults.Any())
        {
            <div class="results-list">
                @foreach (var result in testResults)
                {
                    <div class="result-item @result.StatusClass">
                        <div class="result-header">
                            <span class="result-timestamp">@result.Timestamp.ToString("HH:mm:ss.fff")</span>
                            <span class="result-status">@result.Status</span>
                        </div>
                        <div class="result-message">@result.Message</div>
                        @if (!string.IsNullOrEmpty(result.Details))
                        {
                            <div class="result-details">
                                <pre>@result.Details</pre>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-results">
                <i class="fas fa-inbox"></i>
                <p>No test results yet. Execute a test to see results here.</p>
            </div>
        }
    </div>

    <!-- Debug Log Viewer Section -->
    <div class="isolation-logs">
        <h2 class="section-title">
            <i class="fas fa-terminal"></i>
            Debug Logs
            <button class="btn-icon" @onclick="ClearLogs" title="Clear logs">
                <i class="fas fa-trash"></i>
            </button>
        </h2>
        
        <div class="log-viewer">
            @if (debugLogs.Any())
            {
                @foreach (var log in debugLogs)
                {
                    <div class="log-entry @log.LevelClass">
                        <span class="log-timestamp">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                        <span class="log-level">[@log.Level]</span>
                        <span class="log-layer">[@log.Layer]</span>
                        <span class="log-message">@log.Message</span>
                    </div>
                }
            }
            else
            {
                <div class="log-empty">
                    <i class="fas fa-terminal"></i>
                    <p>No debug logs yet. Execute a test with debug logging enabled.</p>
                </div>
            }
        </div>
    </div>

    <!-- Isolated Functionality Section -->
    <div class="isolation-preview">
        <h2 class="section-title">
            <i class="fas fa-eye"></i>
            Live Preview
        </h2>
        
        <div class="preview-container">
            <div class="preview-content">
                @functionalityPreview
            </div>
        </div>
    </div>
</div>

