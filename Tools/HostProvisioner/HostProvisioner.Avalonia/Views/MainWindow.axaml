<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HostProvisioner.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="700"
        x:Class="HostProvisioner.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NOOR Canvas Host Provisioner"
        Width="550" Height="700"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="None">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.modern">
            <Setter Property="Background" Value="#006400"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modern:pointerover">
            <Setter Property="Background" Value="#005000"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#C5B358"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#B5A348"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        
        <Style Selector="TextBox.modern">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.modern:focus">
            <Setter Property="BorderBrush" Value="#006400"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Gradient Background -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F8F5F1" Offset="0"/>
                    <GradientStop Color="#FEFDFB" Offset="0.5"/>
                    <GradientStop Color="#F8F5F1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Custom Header Bar -->
        <Border Height="60" VerticalAlignment="Top" Background="#006400" CornerRadius="0">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="24" Foreground="White" Margin="0,0,12,0"/>
                    <TextBlock Text="NOOR Canvas Host Provisioner" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Close Button -->
                <Button Content="✕" 
                        Width="50" Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,10,10,0"
                        Background="Transparent"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#B40000"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Card -->
        <Border Margin="30,90,30,30" 
                Background="White" 
                CornerRadius="24" 
                BoxShadow="0 8 32 0 #20000000">
            <ScrollViewer>
                <StackPanel Margin="40,30">
                    
                    <!-- Logo -->
                    <Border Width="120" Height="120" 
                            Background="Transparent" 
                            CornerRadius="60" 
                            HorizontalAlignment="Center"
                            BoxShadow="0 4 16 0 #15000000">
                        <Image Source="/Assets/NoorCanvas.png" 
                               Width="100" 
                               Height="100" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Host Provisioner" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="#006400" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,10"/>

                    <!-- Environment Info Card -->
                    <Border Background="#F8F5F1" 
                            CornerRadius="12" 
                            Padding="20" 
                            Margin="0,20,0,30">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding EnvironmentInfo}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="#4B3C2B"/>
                            <TextBlock Text="{Binding BaseUrlInfo}" 
                                       FontSize="11" 
                                       Foreground="#6B5C4B"/>
                            <TextBlock Text="{Binding DatabaseInfo}" 
                                       FontSize="11" 
                                       Foreground="#6B5C4B"/>
                        </StackPanel>
                    </Border>

                    <!-- Session ID Input -->
                    <TextBlock Text="Session ID" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#4B3C2B" 
                               Margin="0,0,0,8"/>
                    <TextBox Classes="modern" 
                             Name="txtSessionId"
                             Text="{Binding SessionId}" 
                             Watermark="Enter Session ID (e.g., 212)"
                             HorizontalContentAlignment="Center"
                             KeyDown="TxtSessionId_KeyDown"/>

                    <!-- Generate Button -->
                    <Button Classes="modern" 
                            Name="btnGenerate"
                            Content="🎫 Generate Host Token" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Margin="0,20,0,0"
                            Command="{Binding GenerateTokenCommand}"/>

                    <!-- Host Token Section -->
                    <StackPanel IsVisible="{Binding HasHostToken}" Margin="0,30,0,0">
                        <TextBlock Text="🎟️ Host Token" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4B3C2B" 
                                   Margin="0,0,0,8"/>
                        
                        <!-- Token Display Card -->
                        <Border Background="#F0FFF0" 
                                BorderBrush="#006400" 
                                BorderThickness="2" 
                                CornerRadius="12" 
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding HostToken}" 
                                           FontFamily="Consolas" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#006400" 
                                           TextWrapping="Wrap"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <Button Classes="secondary" 
                                            Content="📋 Copy Token" 
                                            Command="{Binding CopyHostTokenCommand}"/>
                                    <Button Classes="secondary" 
                                            Content="🚀 Open in Browser" 
                                            Command="{Binding LaunchHostUrlCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Host URL Display -->
                        <TextBlock Text="{Binding HostUrl}" 
                                   FontSize="11" 
                                   Foreground="#6B5C4B" 
                                   TextWrapping="Wrap" 
                                   Margin="0,12,0,0" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="12" 
                               Foreground="{Binding StatusColor}" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,0" 
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusMessage}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
