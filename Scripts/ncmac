#!/bin/bash
# NOOR Canvas Mac Development Setup Script
# Global command: ncmac
# Purpose: Quickly configure and launch NoorCanvas for Mac development
# Handles switching between Mac and Windows development environments

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ROOT="/Users/asifhussain/NOOR-CANVAS"
PROJECT_DIR="$PROJECT_ROOT/SPA/NoorCanvas"
APPSETTINGS_FILE="$PROJECT_DIR/appsettings.json"
MAC_DB_SERVER="192.168.1.158,1433"
DB_PASSWORD="adf4961glo"

echo -e "${CYAN}========================================${NC}"
echo -e "${CYAN}  NOOR Canvas Mac Setup (ncmac)${NC}"
echo -e "${CYAN}========================================${NC}"

# Step 1: Navigate to project root and pull latest development
echo -e "${BLUE}[1/6]${NC} Pulling latest development branch..."
cd "$PROJECT_ROOT" || { echo -e "${RED}❌ Failed to navigate to project root${NC}"; exit 1; }

# Check current branch and switch to development if needed
CURRENT_BRANCH=$(git branch --show-current)
if [ "$CURRENT_BRANCH" != "development" ]; then
    echo -e "${YELLOW}📋 Current branch: $CURRENT_BRANCH, switching to development...${NC}"
    git checkout development
fi

# Pull latest changes
echo -e "${YELLOW}📡 Pulling latest changes from origin/development...${NC}"
git pull origin development
echo -e "${GREEN}✅ Latest development code pulled${NC}"

# Step 2: Kill any existing processes
echo -e "${BLUE}[2/6]${NC} Cleaning up existing processes..."
pkill -f dotnet 2>/dev/null || echo -e "${YELLOW}⚠️  No existing dotnet processes found${NC}"
sleep 2
echo -e "${GREEN}✅ Process cleanup complete${NC}"

# Step 3: Test database connectivity
echo -e "${BLUE}[3/6]${NC} Testing database connectivity..."
if ping -c 2 192.168.1.158 >/dev/null 2>&1; then
    echo -e "${GREEN}✅ Database server reachable${NC}"
else
    echo -e "${RED}❌ Database server not reachable${NC}"
    exit 1
fi

if nc -zv 192.168.1.158 1433 2>/dev/null; then
    echo -e "${GREEN}✅ SQL Server port accessible${NC}"
else
    echo -e "${RED}❌ SQL Server port not accessible${NC}"
    exit 1
fi

# Step 4: Create/Update Mac-specific appsettings.json
echo -e "${BLUE}[4/6]${NC} Configuring Mac-specific settings..."
cd "$PROJECT_DIR" || { echo -e "${RED}❌ Failed to navigate to project directory${NC}"; exit 1; }

cat > "$APPSETTINGS_FILE" << 'EOF'
{
  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.1.158,1433;Database=KSESSIONS_DEV;User ID=sa;Password=adf4961glo;Connection Timeout=3600;MultipleActiveResultSets=true;TrustServerCertificate=True;Encrypt=False;",
    "_Comment": "Mac development configuration - Auto-generated by ncmac script",
    "_MacNote": "Using IP address for cross-platform compatibility"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/noor-canvas-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Countries": {
    "UseShortlistedCountries": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:9090"
      },
      "Https": {
        "Url": "https://localhost:9091"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 30000000,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "OpenAI": {
    "ApiKey": "",
    "VisionDeploymentName": "gpt-4o",
    "Notes": "Configure OpenAI API key for screenshot annotation extraction"
  }
}
EOF

echo -e "${GREEN}✅ Mac-specific appsettings.json created${NC}"

# Step 5: Build the application
echo -e "${BLUE}[5/6]${NC} Building application..."
if dotnet build --verbosity quiet; then
    echo -e "${GREEN}✅ Build successful${NC}"
else
    echo -e "${RED}❌ Build failed${NC}"
    exit 1
fi

# Step 6: Launch application
echo -e "${BLUE}[6/6]${NC} Launching NoorCanvas application..."
echo -e "${CYAN}🚀 Starting application in background...${NC}"
echo -e "${YELLOW}📍 HTTP:  http://localhost:9090${NC}"
echo -e "${YELLOW}📍 HTTPS: https://localhost:9091${NC}"

# Launch in background with logging
nohup dotnet run > ncmac.log 2>&1 &
APP_PID=$!

# Wait for startup
echo -e "${YELLOW}⏳ Waiting for application to start...${NC}"
sleep 8

# Verify application is running
if kill -0 $APP_PID 2>/dev/null; then
    # Test HTTP response
    if curl -k --connect-timeout 5 -s -o /dev/null -w "%{http_code}" https://localhost:9091 | grep -q "200"; then
        echo -e "${GREEN}🎉 NoorCanvas successfully launched!${NC}"
        echo -e "${GREEN}   Process ID: $APP_PID${NC}"
        echo -e "${GREEN}   Logs: $(pwd)/ncmac.log${NC}"
        echo -e "${CYAN}========================================${NC}"
        echo -e "${CYAN}  Mac Development Environment Ready${NC}"
        echo -e "${CYAN}========================================${NC}"
    else
        echo -e "${YELLOW}⚠️  Application started but HTTP check failed${NC}"
        echo -e "${YELLOW}   Check logs: tail -f $(pwd)/ncmac.log${NC}"
    fi
else
    echo -e "${RED}❌ Application failed to start${NC}"
    echo -e "${RED}   Check logs: tail -f $(pwd)/ncmac.log${NC}"
    exit 1
fi

# Additional helpful information
echo -e "${BLUE}💡 Useful commands:${NC}"
echo -e "   View logs: ${YELLOW}tail -f $(pwd)/ncmac.log${NC}"
echo -e "   Stop app:  ${YELLOW}pkill -f dotnet${NC}"
echo -e "   Restart:   ${YELLOW}ncmac${NC}"
