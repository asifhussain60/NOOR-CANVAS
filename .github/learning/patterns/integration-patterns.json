{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Integration Patterns",
    "description": "Successful cross-agent workflow patterns",
    "type": "object",
    "properties": {
        "patterns": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "pattern_id": {
                        "type": "string",
                        "description": "Unique identifier for this pattern"
                    },
                    "name": {
                        "type": "string",
                        "description": "Human-readable pattern name"
                    },
                    "workflow": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Sequence of agents in this workflow"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of this integration pattern"
                    },
                    "use_case": {
                        "type": "string",
                        "description": "When to use this workflow pattern"
                    },
                    "handoff_strategy": {
                        "type": "string",
                        "description": "How context is passed between agents"
                    },
                    "success_criteria": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Indicators of successful integration"
                    },
                    "learned_from": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Keys that demonstrated this pattern"
                    },
                    "success_rate": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Success rate of this pattern (0.0 to 1.0)"
                    },
                    "last_updated": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When this pattern was last updated"
                    }
                },
                "required": [
                    "pattern_id",
                    "name",
                    "workflow",
                    "description",
                    "use_case"
                ]
            }
        }
    }
}