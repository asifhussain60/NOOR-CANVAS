{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Key Data Stream State",
  "description": "Unified tracking format for key data streams in NOOR CANVAS",
  "type": "object",
  "required": ["key", "status", "created", "lastUpdated"],
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key identifier (kebab-case)",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["planning", "in-progress", "paused", "completed", "archived", "cancelled"],
      "description": "Current key status"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of key creation"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "requests": {
      "type": "array",
      "description": "Chronological history of user requests for this key",
      "items": {
        "type": "object",
        "required": ["timestamp", "type", "userRequest"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": ["original", "additional", "clarification", "modification"],
            "description": "Type of request"
          },
          "userRequest": {
            "type": "string",
            "description": "Full text of user request"
          },
          "promptChain": {
            "type": "array",
            "description": "Sequence of prompts invoked for this request",
            "items": {
              "type": "string"
            }
          },
          "commits": {
            "type": "array",
            "description": "Git commit SHAs generated from this request",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commits": {
      "type": "array",
      "description": "All git commits associated with this key",
      "items": {
        "type": "object",
        "required": ["sha", "message", "timestamp"],
        "properties": {
          "sha": {
            "type": "string",
            "description": "Git commit SHA (short or full)"
          },
          "message": {
            "type": "string",
            "description": "Commit message"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "phase": {
            "type": "integer",
            "description": "Phase number this commit belongs to"
          },
          "author": {
            "type": "string",
            "description": "Commit author"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "description": "Implementation phases from plan.json",
      "items": {
        "type": "object",
        "required": ["number", "title", "status"],
        "properties": {
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["not-started", "in-progress", "completed", "skipped", "blocked"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "commits": {
            "type": "array",
            "description": "Commit SHAs for this phase",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "filesModified": {
      "type": "array",
      "description": "List of all files modified during key execution",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "promptHandoffs": {
      "type": "array",
      "description": "Record of prompt-to-prompt handoffs",
      "items": {
        "type": "object",
        "required": ["from", "to", "timestamp"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source prompt name"
          },
          "to": {
            "type": "string",
            "description": "Target prompt name"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "parameters": {
            "type": "object",
            "description": "Handoff parameters passed"
          }
        }
      }
    },
    "driftKeys": {
      "type": "array",
      "description": "Related drift keys spawned from this key",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "resolved": {
            "type": "boolean"
          }
        }
      }
    },
    "testResults": {
      "type": "object",
      "description": "Test execution results",
      "properties": {
        "unit": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer" },
            "failed": { "type": "integer" },
            "lastRun": { "type": "string", "format": "date-time" }
          }
        },
        "e2e": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer" },
            "failed": { "type": "integer" },
            "lastRun": { "type": "string", "format": "date-time" }
          }
        },
        "visual": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer" },
            "failed": { "type": "integer" },
            "lastRun": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "complexity": {
          "type": "string",
          "enum": ["simple", "moderate", "complex"]
        },
        "classification": {
          "type": "string",
          "enum": ["feature", "bug-fix", "refactor", "optimization", "major-change"]
        },
        "estimatedDuration": {
          "type": "string",
          "description": "Human-readable duration estimate"
        },
        "actualDuration": {
          "type": "string",
          "description": "Actual time taken"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
