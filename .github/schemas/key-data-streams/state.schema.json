{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Key Data Stream State",
    "description": "Unified tracking for key requests, commits, phases, and prompt handoffs",
    "type": "object",
    "required": [
        "key",
        "version",
        "status",
        "created"
    ],
    "properties": {
        "key": {
            "type": "string",
            "description": "Kebab-case key identifier",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
            "type": "string",
            "description": "Schema version",
            "const": "2.0"
        },
        "status": {
            "type": "string",
            "enum": [
                "planning",
                "in-progress",
                "awaiting-approval",
                "completed",
                "paused",
                "cancelled"
            ],
            "description": "Current status of key work"
        },
        "created": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when key was created"
        },
        "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last state update"
        },
        "requests": {
            "type": "array",
            "description": "Chronological history of all user requests for this key",
            "items": {
                "type": "object",
                "required": [
                    "timestamp",
                    "type",
                    "userRequest"
                ],
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "original",
                            "additional",
                            "modification",
                            "clarification"
                        ],
                        "description": "Type of request"
                    },
                    "userRequest": {
                        "type": "string",
                        "description": "Full verbatim user request text"
                    },
                    "promptChain": {
                        "type": "array",
                        "description": "Sequence of prompts invoked for this request",
                        "items": {
                            "type": "string",
                            "examples": [
                                "route",
                                "plan",
                                "task",
                                "test-generation",
                                "drift"
                            ]
                        }
                    },
                    "commits": {
                        "type": "array",
                        "description": "Git commits resulting from this request",
                        "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{7,40}$"
                        }
                    },
                    "outcome": {
                        "type": "string",
                        "enum": [
                            "completed",
                            "in-progress",
                            "blocked",
                            "deferred"
                        ],
                        "description": "Outcome of this specific request"
                    }
                }
            }
        },
        "commits": {
            "type": "array",
            "description": "All git commits associated with this key",
            "items": {
                "type": "object",
                "required": [
                    "sha",
                    "message",
                    "timestamp"
                ],
                "properties": {
                    "sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{7,40}$"
                    },
                    "message": {
                        "type": "string",
                        "description": "Full git commit message"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "author": {
                        "type": "string",
                        "description": "Commit author name"
                    },
                    "phase": {
                        "type": "integer",
                        "description": "Phase number this commit belongs to",
                        "minimum": 0
                    },
                    "checkpointType": {
                        "type": "string",
                        "enum": [
                            "phase-complete",
                            "intermediate",
                            "rollback-tag",
                            "drift",
                            "manual"
                        ],
                        "description": "Type of checkpoint commit"
                    },
                    "filesChanged": {
                        "type": "array",
                        "description": "List of files modified in this commit",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "phases": {
            "type": "array",
            "description": "Phase execution tracking (compatible with existing plan.json)",
            "items": {
                "type": "object",
                "required": [
                    "number",
                    "title",
                    "status"
                ],
                "properties": {
                    "number": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "not-started",
                            "in-progress",
                            "completed",
                            "failed",
                            "skipped"
                        ]
                    },
                    "started": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "completed": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "commits": {
                        "type": "array",
                        "description": "Commit SHAs for this phase",
                        "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{7,40}$"
                        }
                    },
                    "duration": {
                        "type": "string",
                        "description": "Estimated or actual duration",
                        "examples": [
                            "30 min",
                            "2-3 hours"
                        ]
                    },
                    "risk": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high"
                        ],
                        "description": "Risk level for this phase"
                    }
                }
            }
        },
        "filesModified": {
            "type": "array",
            "description": "Aggregate list of all files modified across all commits",
            "items": {
                "type": "string"
            }
        },
        "promptHandoffs": {
            "type": "array",
            "description": "History of prompt-to-prompt handoffs",
            "items": {
                "type": "object",
                "required": [
                    "from",
                    "to",
                    "timestamp"
                ],
                "properties": {
                    "from": {
                        "type": "string",
                        "description": "Source prompt agent",
                        "examples": [
                            "route",
                            "plan",
                            "task",
                            "drift"
                        ]
                    },
                    "to": {
                        "type": "string",
                        "description": "Destination prompt agent"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "parameters": {
                        "type": "object",
                        "description": "Parameters passed during handoff",
                        "additionalProperties": true
                    },
                    "reason": {
                        "type": "string",
                        "description": "Why this handoff occurred"
                    }
                }
            }
        },
        "totalPhases": {
            "type": "integer",
            "description": "Total number of phases (for compatibility with plan.json)",
            "minimum": 0
        },
        "completedPhases": {
            "type": "integer",
            "description": "Number of completed phases",
            "minimum": 0
        },
        "currentPhase": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Current active phase number",
            "minimum": 1
        },
        "branch": {
            "type": "string",
            "description": "Git branch for this work (e.g., 'development', 'feature/xyz')"
        },
        "driftKeys": {
            "type": "array",
            "description": "Related drift keys spawned from this key",
            "items": {
                "type": "object",
                "required": [
                    "key",
                    "severity"
                ],
                "properties": {
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "blocking",
                            "high",
                            "medium",
                            "low"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "resolved",
                            "deferred"
                        ]
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        },
        "tags": {
            "type": "object",
            "description": "Metadata tags for classification",
            "properties": {
                "classification": {
                    "type": "string",
                    "enum": [
                        "minor-change",
                        "moderate-change",
                        "major-change",
                        "breaking-change"
                    ],
                    "description": "Change classification"
                },
                "rollback_tag": {
                    "type": "string",
                    "description": "Git tag for rollback point"
                },
                "requires_explicit_merge_approval": {
                    "type": "boolean"
                }
            },
            "additionalProperties": true
        },
        "estimatedTotalDuration": {
            "type": "string",
            "description": "Human-readable total duration estimate"
        },
        "userDecisions": {
            "type": "object",
            "description": "Questionnaire answers and user decisions",
            "additionalProperties": true
        }
    }
}